---
import Base from '../layouts/Base.astro';
import ProjectSelector from '../components/ProjectSelector.astro';
import Bookmarks from '../components/Bookmarks.astro';
import Contact from '../components/Contact.astro';
import { projects } from '../data/projects';
---
<Base>
  <!-- ============ LAUNCHER ============ -->
  <section class="launch" id="built">
    <div class="launch__inner wrap">
      <p class="eyebrow launch__label">Everything built</p>
      <ProjectSelector items={projects} id="built" />
    </div>
  </section>

  <!-- ============ BOOKMARKS ============ -->
  <section class="section wrap bookmarks" id="bookmarks">
    <p class="eyebrow bookmarks__label">Bookmarks</p>
    <Bookmarks />
  </section>

  <!-- ============ CONTACT ============ -->
  <Contact />
</Base>

<style>
  /* ---- launcher band ----
     No background, no .pxsafe — PixelField's dithered grid AND its
     cursor-tracked heat both paint straight through the content, same as
     everywhere else on the page now (Brayden's explicit call: no boxes
     hiding the pixels, even behind text). `position:relative` still lives
     on `.launch`: the WHOLE positioned subtree paints above the fixed
     z-index:0 canvas together, which is what stacks the text on top — that
     part is unrelated to `.pxsafe` and still needed. */
  .launch {
    position: relative; z-index: 1;
    display: flex; align-items: center;
    padding-block: clamp(2.2rem, 5vh, 3.4rem);
    border-bottom: 1px solid var(--border);
  }
  .launch__inner { width: 100%; }

  .launch__label { margin-bottom: 0.85rem; }

  /* ---- bookmarks ---- */
  .bookmarks { padding-block: clamp(2.8rem, 6vw, 4.5rem); }
  .bookmarks__label { margin-bottom: clamp(1.4rem, 3vw, 2rem); }

  @media (max-width: 560px) {
    .launch { min-height: 0; padding-block: 2rem 3rem; }
  }
</style>
