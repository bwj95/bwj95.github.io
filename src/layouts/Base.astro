---
import '../styles/global.css';
import PixelField from '../components/PixelField.astro';
import Nav from '../components/Nav.astro';
import FlameGlobe from '../components/FlameGlobe.astro';
import { site } from '../data/site';

interface Props { title?: string; description?: string; }
const {
  title = site.title,
  description = site.tagline,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://bwj95.github.io');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0c" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title || site.tagline} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={new URL('/og.png', canonical).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title || site.tagline} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', canonical).href} />

    <!-- fonts: system stack only, same as pixel-playground — no webfont to
         load, see the type note in global.css -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <PixelField />
    <Nav />
    <main id="top">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__inner">
        <div>
          <a class="foot__mark" href="/" aria-label="Home">
            <FlameGlobe class="foot__mark-svg" />
          </a>
          <p class="foot__tag">{site.tagline}</p>
        </div>
        <div class="foot__links">
          <a href="#top">Back to top ↑</a>
          <a href={site.links.github} target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="wrap foot__base">
        <span>© {new Date().getFullYear()}</span>
        <span class="foot__built">Built by hand — Astro + a dithered canvas. The site is its own argument.</span>
      </div>
    </footer>

    <!-- NOTE: the "magnetic button" hover (translate the element toward the
         cursor) was removed — it jitters. Moving the box toward the pointer
         changes the pointer's position relative to it, and near an edge the
         element slides out from under the cursor, firing pointerleave →
         reset → pointerenter, over and over. Hover affordances here change
         paint (colour, shadow, inner content), never the element's own hit
         box. -->
  </body>
</html>

<style>
  /* the top bar is fixed (out of flow) and now floats with a gap above it —
     reserve the gap, the bar's own height, and a matching gap below it so
     content starts clear of the whole floating pill. --nav-h/--nav-gap live
     in global.css; see the note there. */
  main { padding-top: calc(var(--nav-h) + var(--nav-gap) * 2); }

  /* position+z-index (not .pxsafe — the footer doesn't use it, same as
     every other section now): PixelField is fixed at z-index:0, so
     anything meant to read on top of it needs to out-stack it. No
     background either — transparent, so the dithered grid AND the
     cursor-tracked heat both paint straight through, nothing hidden. */
  .foot { position: relative; z-index: 1; border-top: 1px solid var(--border); margin-top: 4rem; padding-block: 3.5rem 2.5rem; }
  .foot__inner { display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between; align-items: flex-start; }
  .foot__mark { --mark-size: clamp(40px, 7vw, 52px); display: inline-block; color: var(--text-dim); transition: color 0.2s var(--ease); }
  .foot__mark:hover { color: var(--accent); }
  .foot__tag { color: var(--text-dim); max-width: 42ch; margin-top: 0.9rem; }
  .foot__links { display: flex; flex-wrap: wrap; gap: 1.4rem; font-family: var(--font-mono); font-size: 0.82rem; }
  .foot__links a { color: var(--text-dim); transition: color 0.2s; }
  .foot__links a:hover { color: var(--text); }
  .foot__base { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); font-family: var(--font-mono); font-size: 0.74rem; color: var(--text-faint); }
</style>
