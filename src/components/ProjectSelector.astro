---
import { KIND_LABEL, type Project } from '../data/projects';
import PixelButton from './PixelButton.astro';
interface Props { items: Project[]; id: string; }
const { items, id } = Astro.props;
const first = items[0];

// Everything in this list is mid-build — flip back to true piece by piece as
// each one is actually finished and ready to deploy, not all at once.
const BUILT_AVAILABLE = false;
---
<div class="sel" data-selector data-built-available={BUILT_AVAILABLE ? '1' : '0'}>
  <div class="sel__bar">
    <div class="sel__dd">
      <button
        type="button"
        class="sel__trigger glass"
        id={`${id}-trigger`}
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls={`${id}-list`}
      >
        <span class="sel__name" data-sel-name>{first?.name}</span>
        <span class="sel__caret" aria-hidden="true"></span>
      </button>

      <ul class="sel__list" id={`${id}-list`} role="listbox" aria-label="Everything built">
        {items.map((p, i) => (
          <li
            class="sel__opt"
            role="option"
            data-desc={p.blurb}
            data-url={p.url}
            data-external={p.external ? '1' : ''}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class="sel__opt-name">{p.name}</span>
            <span class="sel__opt-kind">{BUILT_AVAILABLE ? KIND_LABEL[p.kind] : 'In Progress'}</span>
          </li>
        ))}
      </ul>
    </div>

    <PixelButton
      class="sel__open"
      data-sel-open
      href={BUILT_AVAILABLE ? first?.url : undefined}
      target={BUILT_AVAILABLE && first?.external ? '_blank' : undefined}
      rel={BUILT_AVAILABLE && first?.external ? 'noopener' : undefined}
      disabled={BUILT_AVAILABLE ? undefined : true}
      aria-disabled={BUILT_AVAILABLE ? undefined : 'true'}
    >
      {BUILT_AVAILABLE
        ? <>Open <span class="sel__open-glyph" aria-hidden="true">▸</span></>
        : 'In progress'}
    </PixelButton>
  </div>

  <p class="sel__desc" data-sel-desc-text>{first?.blurb}</p>
</div>

<style>
  .sel { width: 100%; max-width: 620px; }

  .sel__bar { display: flex; gap: 0.7rem; align-items: center; }

  .sel__dd { position: relative; flex: 1 1 auto; min-width: 0; }

  .sel__trigger {
    width: 100%;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius);
    font-size: 0.88rem; color: var(--text); text-align: left;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .sel__trigger:hover { border-color: var(--border-bright); }
  .sel__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .sel__caret {
    flex: 0 0 auto; width: 9px; height: 9px;
    border-right: 2px solid var(--text-dim); border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.25s var(--ease), border-color 0.2s var(--ease);
  }
  .sel__trigger[aria-expanded="true"] .sel__caret { transform: rotate(-135deg) translate(-2px, -2px); }

  .sel__list {
    position: absolute; top: calc(100% + 0.4rem); left: 0; right: 0; z-index: 20;
    list-style: none; padding: 0.3rem; margin: 0;
    /* Opaque paper, not .glass/blur: a backdrop-filter popup over the moving
       PixelField canvas mis-composited in the previous design (rounded into
       a blob that clipped option text). Solid ground is also just more
       readable over an animated background. */
    background: var(--paper);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    display: flex; flex-direction: column; gap: 0.05rem;
    max-height: min(58vh, 400px); overflow-y: auto; overscroll-behavior: contain;
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
  }
  .sel__list.is-open { opacity: 1; visibility: visible; transform: translateY(0); }

  .sel__opt {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding: 0.5rem 0.72rem; border-radius: 0;
    color: var(--text-dim); font-size: 0.87rem; cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .sel__opt:hover { color: var(--text); background: var(--panel-2); }
  .sel__opt[aria-selected="true"] { color: var(--text); background: var(--panel-2); }
  .sel__opt-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sel__opt-kind {
    flex: 0 0 auto;
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--text-faint);
  }
  .sel__opt[aria-selected="true"] .sel__opt-kind { color: var(--accent); }

  /* ---- Open: the shared PixelButton (dither hover fill, pixel-clipped
     corners) — just its sizing as a flex item next to the dropdown trigger.
     The old extruded-glass lozenge + pointer-tracked specular highlight is
     gone with the shader it was lit to match; see PixelButton.astro for the
     actual button treatment. */
  :global(.sel__open) {
    flex: 0 0 auto; align-self: center;
    white-space: nowrap;
    padding: 0 1rem;
    height: 38px;
    font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.04em;
  }
  .sel__open-glyph { display: inline-block; transition: translate 0.2s var(--ease); }
  :global(.sel__open:hover) .sel__open-glyph { translate: 2px 0; }
  :global(.sel__open:disabled) {
    opacity: 0.5;
    cursor: not-allowed;
    background: var(--panel-2);
    color: var(--text-faint);
  }
  @media (prefers-reduced-motion: reduce) {
    .sel__open-glyph { transition: none; }
  }

  .sel__desc {
    margin-top: 0.9rem;
    color: var(--text-dim); line-height: 1.6; font-size: 0.95rem;
    min-height: 2.6em;
  }

  @media (max-width: 520px) {
    .sel__desc { min-height: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sel__caret, .sel__list { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-selector]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.sel__trigger')!;
    const list = root.querySelector<HTMLElement>('.sel__list')!;
    const nameEl = root.querySelector<HTMLElement>('[data-sel-name]')!;
    const descText = root.querySelector<HTMLElement>('[data-sel-desc-text]')!;
    const openBtn = root.querySelector<HTMLAnchorElement>('[data-sel-open]')!;

    const opts = [...root.querySelectorAll<HTMLElement>('.sel__opt')];
    const available = root.dataset.builtAvailable === '1';
    let idx = 0;

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
    const openList = () => { list.classList.add('is-open'); trigger.setAttribute('aria-expanded', 'true'); };
    const closeList = () => { list.classList.remove('is-open'); trigger.setAttribute('aria-expanded', 'false'); };

    const select = (i: number, scroll = true) => {
      idx = Math.max(0, Math.min(i, opts.length - 1));
      opts.forEach((o, k) => o.setAttribute('aria-selected', String(k === idx)));
      nameEl.textContent = opts[idx].querySelector('.sel__opt-name')?.textContent || '';
      descText.textContent = opts[idx].getAttribute('data-desc') || '';

      // Unavailable build: openBtn renders as a real <button disabled>, not an
      // <a> — leave it with no href so there's never anything to navigate to,
      // even if a selection changes underneath it.
      if (available) {
        openBtn.href = opts[idx].getAttribute('data-url') || '#';
        if (opts[idx].getAttribute('data-external') === '1') {
          openBtn.target = '_blank'; openBtn.rel = 'noopener';
        } else {
          openBtn.removeAttribute('target'); openBtn.removeAttribute('rel');
        }
      }
      if (scroll) opts[idx].scrollIntoView({ block: 'nearest' });
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeList() : openList();
    });

    opts.forEach((o, i) =>
      o.addEventListener('click', () => { select(i); closeList(); trigger.focus(); })
    );

    // keyboard: arrows move selection, Enter opens the selected piece, Escape closes
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); isOpen() ? select(idx + 1) : openList(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); isOpen() ? select(idx - 1) : openList(); }
      else if (e.key === 'Escape') closeList();
    });

    document.addEventListener('click', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) closeList();
    });
  });
</script>
