---
import type { Project } from '../data/projects';
interface Props { items: Project[]; id: string; }
const { items, id } = Astro.props;
const first = items[0];
---
<div class="sel" data-selector>
  <div class="sel__bar">
    <!-- dropdown of project names -->
    <div class="sel__dd">
      <button
        type="button"
        class="sel__trigger glass"
        id={`${id}-trigger`}
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-controls={`${id}-list`}
      >
        <span class="sel__name" data-sel-name>{first?.name}</span>
        <span class="sel__caret" aria-hidden="true"></span>
      </button>

      <ul class="sel__list glass" id={`${id}-list`} role="listbox" aria-label="Projects">
        {items.map((p, i) => (
          <li
            class="sel__opt"
            role="option"
            data-value={i}
            data-desc={p.blurb}
            aria-selected={i === 0 ? 'true' : 'false'}
          >{p.name}</li>
        ))}
      </ul>
    </div>

    <!-- info button → reveals the selected project's description -->
    <button
      type="button"
      class="sel__info"
      data-sel-info
      aria-expanded="false"
      aria-controls={`${id}-desc`}
      aria-label="Show description"
    >
      <span class="sel__info-glyph" aria-hidden="true">i</span>
      <span class="sel__info-label">Info</span>
    </button>
  </div>

  <div class="sel__desc glass" id={`${id}-desc`} data-sel-desc hidden>
    <p data-sel-desc-text>{first?.blurb}</p>
  </div>
</div>

<style>
  .sel { max-width: 640px; }

  .sel__bar { display: flex; gap: 0.7rem; align-items: stretch; }

  /* ---- dropdown ---- */
  .sel__dd { position: relative; flex: 1 1 auto; min-width: 0; }

  .sel__trigger {
    width: 100%;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.9rem 1.1rem;
    font-size: 1rem; color: var(--text); text-align: left;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .sel__trigger:hover { border-color: var(--border-bright); }
  .sel__name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .sel__caret {
    flex: 0 0 auto; width: 9px; height: 9px;
    border-right: 2px solid var(--text-dim); border-bottom: 2px solid var(--text-dim);
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform 0.25s var(--ease), border-color 0.2s var(--ease);
  }
  .sel__trigger[aria-expanded="true"] .sel__caret { transform: rotate(-135deg) translate(-2px, -2px); }

  .sel__list {
    position: absolute; top: calc(100% + 0.5rem); left: 0; right: 0; z-index: 20;
    list-style: none; padding: 0.4rem; margin: 0;
    display: flex; flex-direction: column; gap: 0.1rem;
    max-height: 320px; overflow-y: auto;
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.5);
  }
  .sel__list.open { opacity: 1; visibility: visible; transform: translateY(0); }

  .sel__opt {
    padding: 0.7rem 0.9rem; border-radius: max(6px, calc(var(--radius-sm) - 6px));
    color: var(--text-dim); font-size: 0.96rem; cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  .sel__opt:hover { color: var(--text); background: var(--panel-2); }
  .sel__opt[aria-selected="true"] { color: var(--text); background: var(--panel-2); }
  .sel__opt[aria-selected="true"]::after { content: '✦'; float: right; color: var(--accent); }

  /* ---- info button ---- */
  .sel__info {
    flex: 0 0 auto;
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0 1.1rem;
    font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.06em;
    color: var(--text-dim); background: var(--panel);
    border: 1px solid var(--border); border-radius: var(--radius);
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .sel__info:hover, .sel__info[aria-expanded="true"] { color: var(--text); border-color: var(--border-bright); }
  .sel__info-glyph {
    display: grid; place-items: center; width: 18px; height: 18px;
    font-family: var(--font-display); font-style: italic; font-size: 0.82rem; line-height: 1;
    border: 1px solid currentColor; border-radius: 50%;
  }

  /* ---- description reveal ---- */
  .sel__desc {
    margin-top: 0.7rem; padding: 1.1rem 1.2rem;
    color: var(--text-dim); line-height: 1.6; font-size: 0.98rem;
    animation: sel-desc-in 0.35s var(--ease) both;
  }
  .sel__desc[hidden] { display: none; }
  @keyframes sel-desc-in { from { opacity: 0; translate: 0 -6px; } to { opacity: 1; translate: 0 0; } }

  @media (max-width: 520px) {
    .sel__info-label { display: none; }
    .sel__info { padding: 0 0.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sel__caret, .sel__list, .sel__desc { transition: none; animation: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-selector]').forEach((root) => {
    const trigger = root.querySelector<HTMLButtonElement>('.sel__trigger')!;
    const list = root.querySelector<HTMLElement>('.sel__list')!;
    const nameEl = root.querySelector<HTMLElement>('[data-sel-name]')!;
    const infoBtn = root.querySelector<HTMLButtonElement>('[data-sel-info]')!;
    const desc = root.querySelector<HTMLElement>('[data-sel-desc]')!;
    const descText = root.querySelector<HTMLElement>('[data-sel-desc-text]')!;
    const opts = [...root.querySelectorAll<HTMLElement>('.sel__opt')];
    let idx = 0;

    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
    const closeInfo = () => { desc.setAttribute('hidden', ''); infoBtn.setAttribute('aria-expanded', 'false'); };
    const openInfo = () => { closeList(); desc.removeAttribute('hidden'); infoBtn.setAttribute('aria-expanded', 'true'); };
    // dropdown and info are mutually exclusive — opening the list closes the info panel
    const openList = () => { closeInfo(); list.classList.add('open'); trigger.setAttribute('aria-expanded', 'true'); };
    const closeList = () => { list.classList.remove('open'); trigger.setAttribute('aria-expanded', 'false'); };

    const select = (i: number) => {
      idx = Math.max(0, Math.min(i, opts.length - 1));
      opts.forEach((o, k) => o.setAttribute('aria-selected', String(k === idx)));
      nameEl.textContent = opts[idx].textContent;
      descText.textContent = opts[idx].getAttribute('data-desc') || '';
      opts[idx].scrollIntoView({ block: 'nearest' });
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeList() : openList();
    });

    opts.forEach((o, i) =>
      o.addEventListener('click', () => { select(i); closeList(); trigger.focus(); })
    );

    // info button toggles the description; opening it closes the dropdown
    infoBtn.addEventListener('click', () => {
      desc.hasAttribute('hidden') ? openInfo() : closeInfo();
    });

    // keyboard: arrows move selection, Escape closes
    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); isOpen() ? select(idx + 1) : openList(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); isOpen() ? select(idx - 1) : openList(); }
      else if (e.key === 'Escape') closeList();
    });

    // close on outside click
    document.addEventListener('click', (e) => {
      if (isOpen() && !root.contains(e.target as Node)) closeList();
    });
  });
</script>
