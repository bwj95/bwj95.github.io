---
// Grasshopper mark — the site's identity / home mark (bwj95.github.io is this site).
// Stroke uses currentColor, so it inherits the live accent and recolors with the theme.
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<svg
  class={`gh ${cls}`}
  viewBox="0 0 64 48"
  role="img"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="4"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- body (thick rounded capsule, tail → thorax) -->
  <path d="M9 29 L40 25" stroke-width="8" />
  <!-- head -->
  <circle cx="44.5" cy="24" r="5.4" fill="currentColor" stroke="none" />
  <!-- antennae, sweeping forward -->
  <path d="M46 19 C52 12 56 10 60 6" stroke-width="2.3" />
  <path d="M45 17 C49 11 51 8 54 4" stroke-width="2.3" />
  <!-- hind jump leg: thick femur up-and-back to a high knee, tibia folds down -->
  <path d="M28 25 L13 9" stroke-width="7" />
  <path d="M13 9 L21 43" stroke-width="3" />
  <!-- front + mid legs -->
  <path d="M33 26 L31 43" stroke-width="2.6" />
  <path d="M38 25 L39 43" stroke-width="2.6" />
</svg>

<style>
  /* Self-sized so it works no matter which component renders it (Astro scopes
     styles per-component; a parent's width rule would not reach this svg). Color
     inherits via currentColor from the parent. Override size with --gh-size. */
  .gh {
    width: var(--gh-size, 32px);
    height: auto;
    display: block;
    filter: drop-shadow(0 0 9px color-mix(in srgb, currentColor 45%, transparent));
  }
</style>
