---
// PixelField.astro — the pixel-theme's interactive canvas background.
// Ported from Cooking/Pot/pixel-playground/src/components/PixelGrid.astro
// (itself inspired by craft.wild.as) and made theme-aware 2026-08-25: the
// original hardcoded white paper + fixed hex bands, so it only ever worked
// on a light page. This reads --paper/--line/--navy/--blue/--yellow/
// --red/--neon from CSS (see tokens.css) at boot AND on every OS theme
// flip, so the same file is correct in light and dark without edits.
//
// A hidden backing store accumulates "heat" wherever the cursor (or, when
// idle, a couple of wandering points — bounce/orbit/lissajous/drift, picked
// at random) has passed; heat fades every
// frame and is re-thresholded into the BANDS colour ramp each frame, so the
// visible grid is always a live function of recent pointer activity, not a
// texture. A click on empty space drops an explosion (shockwave heat ring +
// particle debris) — real interactive elements (see the click handler's
// exclusion list) never trigger one. `.pxsafe` elements carve out a no-draw
// rectangle (+24px pad) so page content never gets pixels drawn under it.
//
// Usage: <PixelField /> — one per page, behind everything (z-index:0,
// pointer-events:none). Requires tokens.css loaded first.
interface Props {
  controls?: boolean; // show the bottom-left cell/brush size widget (default true)
}
const { controls = true } = Astro.props;
---
<canvas id="pixelfield" aria-hidden="true"></canvas>

{controls && (
  <div class="pxctl" id="pxctl">
    <span class="lbl">Cell</span>
    <button data-cell="22">L</button>
    <button data-cell="14">M</button>
    <button data-cell="9" class="on">S</button>

    <span class="lbl">Brush</span>
    <button data-brush="16">L</button>
    <button data-brush="10" class="on">M</button>
    <button data-brush="7">S</button>
  </div>
)}

<style>
  #pixelfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    pointer-events: none;
  }

  .pxctl {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 7px 9px;
    background: rgba(var(--paper-rgb), 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line);
    border-radius: 10px;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .pxctl .lbl { color: var(--muted); margin: 0 3px; }
  .pxctl .lbl:first-child { margin-left: 0; }

  .pxctl button {
    font: inherit;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    border-radius: 6px;
    cursor: pointer;
    padding: 0;
    transition: background 0.15s, border-color 0.15s;
  }

  .pxctl button:hover { border-color: var(--ink); }

  .pxctl button.on {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  @media (max-width: 720px) {
    .pxctl { display: none; }
  }
</style>

<script>
  (function () {
    const cv = document.getElementById('pixelfield') as HTMLCanvasElement;
    if (!cv) return;
    const ctx = cv.getContext('2d');
    if (!ctx) return;

    let DPR = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0, H = 0;
    let cell = 9;
    let BRUSH = 10;
    let cols = 0, rows = 0;
    let heat: Float32Array;
    // -1 = "no owner, use the shared magnitude ramp" (cursor/clicks/waves,
    // unchanged behaviour); >=0 = index into WANDER_PALETTE, set only by
    // idle wanderers so each one paints its own hue instead of all of them
    // resolving through the same navy->blue->yellow->red ramp.
    let heatColor: Int8Array;
    let t = 0;
    const SEED = Math.random() * 1000;

    let waves: Array<{ x: number; y: number; t0: number; pow: number }> = [];
    let shake = 0;
    let mx = -1, my = -1;
    let hov = false;
    let lastMove = 0;

    // Theme-aware palette — read from CSS custom properties, not hardcoded,
    // and rebuilt whenever the OS theme flips so the canvas repaints in the
    // new palette on the very next frame (no reload needed).
    let PAPER = '#ffffff', GRID_LINE = 'rgba(10,10,10,0.12)';
    let BANDS: Array<[number, string]> = [];
    let NEON = '#d8ff00';
    // One hue per idle wanderer, same 5 tokens the rest of the theme uses —
    // no new colours invented, just a different assignment than the fixed
    // magnitude ramp above.
    let WANDER_PALETTE: string[] = [];
    function readPalette() {
      const s = getComputedStyle(document.documentElement);
      const v = (name: string, fallback: string) => (s.getPropertyValue(name).trim() || fallback);
      PAPER = v('--paper', '#ffffff');
      // --line, not --paper-alt: the grid needs to actually READ as a grid.
      // --paper-alt is a near-invisible card-fill tint (by design, for
      // .glass panels) — against dark paper the two are close enough in
      // luminance that the whole dithered background read as a flat black
      // box. --line is the token already tuned to be a faint but VISIBLE
      // hairline in both themes.
      GRID_LINE = v('--line', 'rgba(10,10,10,0.12)');
      NEON = v('--neon', '#d8ff00');
      BANDS = [
        [0.30, v('--navy', '#1c2541')],
        [0.46, v('--blue', '#3b5bd9')],
        [0.62, v('--yellow', '#f5c518')],
        [0.78, v('--red', '#e0492a')],
      ];
      WANDER_PALETTE = [
        v('--navy', '#1c2541'), v('--blue', '#3b5bd9'), v('--yellow', '#f5c518'),
        v('--red', '#e0492a'), v('--neon', '#d8ff00'),
      ];
    }
    readPalette();
    matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', readPalette);
    // Also catches a manual data-theme override flipping (see tokens.css).
    new MutationObserver(readPalette).observe(document.documentElement, {
      attributes: true, attributeFilter: ['data-theme'],
    });

    interface AnimeParticle {
      x: number; y: number; vx: number; vy: number; rad: number;
      life: number; decay: number; drag: number; gravity: number;
      type: 'puff' | 'debris';
    }
    let animeParticles: AnimeParticle[] = [];

    function spawnAnimeExplosion(x: number, y: number) {
      shake = 4.5;
      waves.push({ x, y, t0: performance.now() / 1000, pow: 3.5 });

      const numPuffs = 20 + Math.floor(Math.random() * 10);
      for (let i = 0; i < numPuffs; i++) {
        const ang = Math.random() * Math.PI * 2;
        const spd = 1.5 + Math.random() * 4.5;
        const dist = Math.random() * 12;
        animeParticles.push({
          x: x + Math.cos(ang) * dist, y: y + Math.sin(ang) * dist,
          vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd,
          rad: 14 + Math.random() * 22, life: 1.0,
          decay: 0.02 + Math.random() * 0.015, drag: 0.91, gravity: -0.06, type: 'puff',
        });
      }
      const numDebris = 25 + Math.floor(Math.random() * 15);
      for (let i = 0; i < numDebris; i++) {
        const ang = Math.random() * Math.PI * 2;
        const spd = 6.0 + Math.random() * 10.0;
        animeParticles.push({
          x, y, vx: Math.cos(ang) * spd, vy: Math.sin(ang) * spd,
          rad: cell * 0.8, life: 0.8 + Math.random() * 0.4,
          decay: 0.025 + Math.random() * 0.02, drag: 0.96, gravity: 0.12, type: 'debris',
        });
      }
    }

    // Exposes the current cell size to CSS, so anything meant to visually
    // pass as part of the grid (the nav's menu icon, currently) can size
    // itself off the SAME number instead of a guessed/hardcoded constant —
    // stays correct even if the cell-size control (bottom-left) is used.
    function syncCellVar() {
      document.documentElement.style.setProperty('--px-cell', cell + 'px');
    }
    function size() {
      W = window.innerWidth; H = window.innerHeight;
      cv.width = Math.round(W * DPR); cv.height = Math.round(H * DPR);
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
      cols = Math.ceil(W / cell) + 1;
      rows = Math.ceil(H / cell) + 1;
      heat = new Float32Array(cols * rows);
      heatColor = new Int8Array(cols * rows).fill(-1);
      syncCellVar();
    }
    size();
    window.addEventListener('resize', size);

    function hsh(c: number, r: number) {
      const n = Math.sin(c * 127.1 + r * 311.7 + SEED * 0.13) * 43758.5453;
      return n - Math.floor(n);
    }
    function base(nx: number, ny: number, tt: number) {
      const s = SEED;
      nx += Math.sin(ny * 5 + tt * 0.5 + s) * 0.05;
      ny += Math.cos(nx * 5 - tt * 0.4) * 0.05;
      const v = Math.sin(nx * 5.6 + s * 1.3 + tt * 0.3) *
                Math.cos(ny * 4.7 - s * 0.7 + tt * 0.22) +
                Math.sin((nx * 1.4 + ny * 1.7) * 4.1 - s + tt * 0.16) +
                Math.sin(ny * 9 + s * 2.1 + nx * 3) * 0.5 +
                Math.sin(nx * 13 - s * 1.7) * 0.28;
      return 0.5 + 0.5 * (v / 2.55);
    }
    function region(nx: number, ny: number, tt: number) {
      return 0.5 + 0.5 * Math.sin(nx * 2.1 + tt * 0.12 + SEED * 0.7) * Math.cos(ny * 1.8 - tt * 0.09 + SEED * 0.3);
    }

    // colorIdx: -1 (default) leaves each touched cell's colour tag alone if
    // it's already a strong contribution, otherwise clears it back to "use
    // the shared magnitude ramp" — an idle wanderer's leftover tint gets
    // painted over the instant the real cursor (or a click wave) revisits
    // that cell. >=0 stamps the cell as owned by that WANDER_PALETTE hue.
    function dep(x: number, y: number, amt: number, sig: number, colorIdx = -1) {
      const cc = x / cell, cr = y / cell;
      const rad = Math.ceil(sig * 1.6);
      const inv = 1 / (2 * sig * sig * 0.18);
      for (let dr = -rad; dr <= rad; dr++) {
        for (let dc = -rad; dc <= rad; dc++) {
          const c = (cc + dc) | 0, r = (cr + dr) | 0;
          if (c < 0 || r < 0 || c >= cols || r >= rows) continue;
          const dx = c + 0.5 - cc, dy = r + 0.5 - cr;
          const w = Math.exp(-(dx * dx + dy * dy) * inv);
          if (w < 0.02) continue;
          const id = r * cols + c;
          const vv = heat[id] + amt * w;
          heat[id] = vv > 1 ? 1 : vv;
          if (w > 0.05) heatColor[id] = colorIdx;
        }
      }
    }

    let pmx = -1, pmy = -1;
    function follow(x: number, y: number, sig: number) {
      if (pmx < 0) { pmx = x; pmy = y; }
      const dx = x - pmx, dy = y - pmy;
      const dl = Math.sqrt(dx * dx + dy * dy);
      const steps = Math.max(1, Math.min(48, Math.round(dl / (cell * 0.8))));
      for (let s = 1; s <= steps; s++) {
        const f = s / steps;
        dep(pmx + dx * f, pmy + dy * f, 0.16, sig);
      }
      pmx = x; pmy = y;
    }

    // Idle animation: a couple of wandering points drift the viewport,
    // depositing heat as they go so each leaves a gentle comet-tail through
    // the SAME dep()/decay machinery the cursor's own trail uses — no
    // separate rendering path needed. Each point is independently assigned
    // one of four motion kinds at random whenever a new idle period starts,
    // so which mix shows up (and where) is different every time:
    //   bounce     — DVD-logo screensaver bounce off the viewport edges.
    //   orbit      — circles a slowly drifting center point.
    //   lissajous  — a Lissajous curve (two out-of-sync sine waves), the
    //                same "orbiting" figure language as the customizer globe.
    //   drift      — an organic random-walk meander that steers itself back
    //                toward center instead of hard-bouncing off edges.
    type WanderKind = 'bounce' | 'orbit' | 'lissajous' | 'drift';
    const WANDER_KINDS: WanderKind[] = ['bounce', 'orbit', 'lissajous', 'drift'];
    interface Wanderer {
      kind: WanderKind;
      colorIdx: number; // index into WANDER_PALETTE — this point's own hue
      x: number; y: number;
      vx: number; vy: number; // bounce; also drives the orbit center's drift
      cx: number; cy: number; ang: number; angVel: number; radius: number; // orbit
      ampX: number; ampY: number; fx: number; fy: number; phase: number; age: number; // lissajous
      heading: number; speed: number; // drift
    }
    function spawnWanderer(x: number, y: number): Wanderer {
      const kind = WANDER_KINDS[Math.floor(Math.random() * WANDER_KINDS.length)];
      const ang0 = Math.random() * Math.PI * 2;
      const spd = 1.6 + Math.random() * 1.1;
      return {
        kind, x, y,
        colorIdx: Math.floor(Math.random() * WANDER_PALETTE.length),
        vx: Math.cos(ang0) * spd, vy: Math.sin(ang0) * spd,
        cx: x, cy: y,
        ang: Math.random() * Math.PI * 2,
        angVel: (Math.random() < 0.5 ? -1 : 1) * (0.012 + Math.random() * 0.02),
        radius: 40 + Math.random() * 90,
        ampX: 50 + Math.random() * 130, ampY: 50 + Math.random() * 130,
        fx: 0.4 + Math.random() * 0.6, fy: 0.4 + Math.random() * 0.9,
        phase: Math.random() * Math.PI * 2, age: 0,
        heading: ang0, speed: 1.2 + Math.random() * 1.1,
      };
    }
    let wanderers: Wanderer[] = [];
    let wanderOn = false;
    function initWander(restx: number, resty: number) {
      wanderOn = true;
      wanderers = [];
      const n = 2;
      const usedColors = new Set<number>();
      for (let i = 0; i < n; i++) {
        const w = spawnWanderer(i === 0 ? restx : Math.random() * W, i === 0 ? resty : Math.random() * H);
        // keep simultaneous points visually distinct instead of leaving it
        // to chance that two land on the same hue
        while (usedColors.has(w.colorIdx) && usedColors.size < WANDER_PALETTE.length) {
          w.colorIdx = Math.floor(Math.random() * WANDER_PALETTE.length);
        }
        usedColors.add(w.colorIdx);
        wanderers.push(w);
      }
    }
    function stepWanderer(w: Wanderer) {
      const pad = 24;
      switch (w.kind) {
        case 'bounce':
          w.x += w.vx; w.y += w.vy;
          if (w.x < pad) { w.x = pad; w.vx = Math.abs(w.vx); }
          else if (w.x > W - pad) { w.x = W - pad; w.vx = -Math.abs(w.vx); }
          if (w.y < pad) { w.y = pad; w.vy = Math.abs(w.vy); }
          else if (w.y > H - pad) { w.y = H - pad; w.vy = -Math.abs(w.vy); }
          break;
        case 'orbit': {
          const rpad = pad + w.radius;
          w.cx += w.vx; w.cy += w.vy;
          if (w.cx < rpad) { w.cx = rpad; w.vx = Math.abs(w.vx); }
          else if (w.cx > W - rpad) { w.cx = W - rpad; w.vx = -Math.abs(w.vx); }
          if (w.cy < rpad) { w.cy = rpad; w.vy = Math.abs(w.vy); }
          else if (w.cy > H - rpad) { w.cy = H - rpad; w.vy = -Math.abs(w.vy); }
          w.ang += w.angVel;
          w.x = w.cx + Math.cos(w.ang) * w.radius;
          w.y = w.cy + Math.sin(w.ang) * w.radius;
          break;
        }
        case 'lissajous':
          w.age += 0.016 * w.speed;
          w.x = w.cx + Math.sin(w.age * w.fx + w.phase) * w.ampX;
          w.y = w.cy + Math.sin(w.age * w.fy) * w.ampY;
          break;
        case 'drift':
          w.heading += (Math.random() - 0.5) * 0.15;
          w.x += Math.cos(w.heading) * w.speed;
          w.y += Math.sin(w.heading) * w.speed;
          if (w.x < pad || w.x > W - pad || w.y < pad || w.y > H - pad) {
            // steer back toward center instead of a hard bounce — reads as
            // organic wandering rather than a screensaver ricochet.
            w.heading = Math.atan2(H / 2 - w.y, W / 2 - w.x) + (Math.random() - 0.5) * 0.6;
          }
          break;
      }
    }
    function wander(restx: number, resty: number, ns: number) {
      if (!wanderOn) initWander(restx, resty);
      for (const w of wanderers) {
        stepWanderer(w);
        dep(w.x, w.y, 0.10, BRUSH * 1.6, w.colorIdx);
      }
    }

    window.addEventListener('pointermove', function (e) {
      lastMove = performance.now() / 1000;
      wanderOn = false;
      mx = e.clientX; my = e.clientY; hov = true;
    });
    window.addEventListener('click', function (e) {
      // Explode only on genuinely empty space. `a, button, input` alone
      // missed real interactive surfaces that aren't one of those tags:
      // dropdown OPTIONS are <li role="option">, the options panel itself
      // is <ul role="listbox">, and the bookmarks/contact section toggles
      // are <summary> — none of those are a, button, or input. [role]
      // catches the first two semantically (every listbox/option/combobox
      // in this codebase is already ARIA-marked for a11y, so this piggy-
      // backs on that instead of hand-listing every current and future
      // dropdown class); .glass catches the floating panels themselves
      // (search results, contact form, mobile menu, the dropdown trigger)
      // so a click landing in a panel's padding doesn't explode either.
      if ((e.target as HTMLElement).closest(
        'a, button, input, textarea, select, summary, [role], .glass, .pxctl, .smiley, .smiley-wrapper'
      )) return;
      spawnAnimeExplosion(e.clientX, e.clientY);
    });

    let safes: Array<[number, number, number, number, number]> = [];
    function updateSafes() {
      safes = [];
      document.querySelectorAll('.pxsafe').forEach((el) => {
        const b = el.getBoundingClientRect();
        if (b.width > 0 && b.bottom > 0 && b.top < H) {
          // Tight pad — just enough that text glyphs right at a safe
          // element's edge don't get a coloured cell touching their
          // antialiasing. A generous pad (this was 24) blows the zone out
          // well past the element's own shape — on the floating nav pill
          // that ate the whole strip above/around it, so clicks/heat there
          // couldn't reach the actual top of the screen even though nothing
          // was visually in the way.
          const pad = 6;
          safes.push([b.left - pad, b.top - pad, b.right + pad, b.bottom + pad, cell * 2.4]);
        }
      });
    }

    // Assumes a 6-digit hex token (every WANDER_PALETTE entry is one) —
    // lets a wanderer's own hue still fade in/out with heat magnitude
    // instead of always painting fully solid.
    function hexToRgba(hex: string, a: number) {
      const n = parseInt(hex.slice(1), 16);
      return `rgba(${(n >> 16) & 255},${(n >> 8) & 255},${n & 255},${a})`;
    }

    function render(timestamp: number) {
      t = timestamp;
      const tt = t * 0.001;
      const ns = performance.now() / 1000;
      updateSafes();

      for (let i = 0; i < heat.length; i++) {
        heat[i] *= 0.88;
        if (heat[i] < 0.003) heat[i] = 0;
      }

      if (hov && mx > 0) {
        const idle = ns - lastMove;
        if (idle > 1.5) wander(mx, my, ns); else follow(mx, my, BRUSH);
      }

      for (let wi = waves.length - 1; wi >= 0; wi--) {
        const wv = waves[wi];
        const age = ns - wv.t0;
        if (age > 1.5) { waves.splice(wi, 1); continue; }
        const R = age * Math.hypot(W, H) * 1.7;
        const sig = cell * 5.5 * wv.pow;
        const amp = Math.max(0, 1 - age / 1.5) * 1.2 * wv.pow;
        const inv = 1 / (2 * sig * sig);
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const dx = (c + 0.5) * cell - wv.x, dy = (r + 0.5) * cell - wv.y;
            const dd = Math.sqrt(dx * dx + dy * dy);
            const g = amp * Math.exp(-((dd - R) * (dd - R)) * inv);
            if (g > 0.02) {
              const id = r * cols + c;
              if (g > heat[id]) heat[id] = g;
            }
          }
        }
      }

      ctx!.save();
      if (shake > 0.01) {
        shake *= 0.9;
        ctx!.translate((Math.random() - 0.5) * shake * 20, (Math.random() - 0.5) * shake * 20);
      } else { shake = 0; }

      ctx!.clearRect(-40, -40, W + 80, H + 80);
      ctx!.fillStyle = PAPER;
      ctx!.fillRect(-40, -40, W + 80, H + 80);

      ctx!.strokeStyle = GRID_LINE;
      ctx!.lineWidth = 1;
      ctx!.beginPath();
      for (let gx = 0; gx <= W; gx += cell) { ctx!.moveTo(gx + 0.5, 0); ctx!.lineTo(gx + 0.5, H); }
      for (let gy = 0; gy <= H; gy += cell) { ctx!.moveTo(0, gy + 0.5); ctx!.lineTo(W, gy + 0.5); }
      ctx!.stroke();

      const s = cell - 1;
      for (let r = 0; r < rows; r++) {
        const vy = r * cell;
        const ny = vy / H;
        for (let c = 0; c < cols; c++) {
          const vx = c * cell;
          const nx = vx / W;

          let insideSafe = false;
          for (let si = 0; si < safes.length; si++) {
            const sf = safes[si];
            if (vx >= sf[0] && vx <= sf[2] && vy >= sf[1] && vy <= sf[3]) { insideSafe = true; break; }
          }
          if (insideSafe) continue;

          let v = heat[r * cols + c] * 0.9;
          if (region(nx, ny, tt) > 0.45) {
            v += base(nx, ny, tt) * 0.12 + Math.sin((c * 0.6 + r * 0.8) + tt * 1.7) * 0.04;
          }
          if (v < 0.3) continue;

          const tag = heatColor[r * cols + c];
          let col: string;
          if (v >= 0.86) {
            // hot-core flash stays universal — cursor, clicks, and every
            // wanderer hue alike all crest into the same neon at max heat.
            col = NEON;
          } else if (tag >= 0) {
            // a wanderer owns this cell: its own hue, fading with heat
            // instead of graduating through the shared 4-colour ramp.
            col = hexToRgba(WANDER_PALETTE[tag], Math.min(1, 0.4 + v * 0.75));
          } else {
            col = BANDS[0][1];
            if (v >= BANDS[1][0]) col = BANDS[1][1];
            if (v >= BANDS[2][0]) col = BANDS[2][1];
            if (v >= BANDS[3][0]) col = BANDS[3][1];
          }

          ctx!.fillStyle = col;
          ctx!.fillRect(c * cell, vy, s, s);
        }
      }

      for (let i = animeParticles.length - 1; i >= 0; i--) {
        const p = animeParticles[i];
        p.vx *= p.drag; p.vy *= p.drag; p.vy += p.gravity;
        p.x += p.vx; p.y += p.vy; p.life -= p.decay;
        if (p.life <= 0) animeParticles.splice(i, 1);
      }

      animeParticles.forEach((p) => {
        let col = '#ffffff';
        if (p.type === 'puff') {
          if (p.life > 0.72) col = '#ffffff';
          else if (p.life > 0.48) col = NEON;
          else if (p.life > 0.24) col = BANDS[3][1];
          else col = BANDS[0][1];
        } else {
          col = p.life > 0.5 ? NEON : BANDS[3][1];
        }

        const c0 = Math.floor((p.x - p.rad) / cell), c1 = Math.ceil((p.x + p.rad) / cell);
        const r0 = Math.floor((p.y - p.rad) / cell), r1 = Math.ceil((p.y + p.rad) / cell);
        const rr = p.rad * p.rad;

        ctx!.fillStyle = col;
        for (let r = r0; r <= r1; r++) {
          const vy = r * cell;
          for (let c = c0; c <= c1; c++) {
            if (c < 0 || r < 0 || c >= cols || r >= rows) continue;
            let insideSafe = false;
            const vx = c * cell;
            for (let si = 0; si < safes.length; si++) {
              const sf = safes[si];
              if (vx >= sf[0] && vx <= sf[2] && vy >= sf[1] && vy <= sf[3]) { insideSafe = true; break; }
            }
            if (insideSafe) continue;
            const dx = (c + 0.5) * cell - p.x, dy = (r + 0.5) * cell - p.y;
            if (dx * dx + dy * dy <= rr) ctx!.fillRect(c * cell, vy, s, s);
          }
        }
      });

      // Punch .pxsafe zones fully transparent. The base fill + grid lines
      // above are drawn for the WHOLE canvas in one cheap pass, so unlike
      // the heat/particle loops (which check insideSafe per cell as they
      // go) they still need a separate clear here — otherwise a safe zone
      // has no colour but still shows the grid, which isn't actually
      // transparent, just colourless.
      for (let si = 0; si < safes.length; si++) {
        const sf = safes[si];
        ctx!.clearRect(sf[0], sf[1], sf[2] - sf[0], sf[3] - sf[1]);
      }

      ctx!.restore();
    }

    function loop(timestamp: number) {
      render(timestamp);
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);

    const pxctl = document.getElementById('pxctl');
    if (pxctl) {
      pxctl.addEventListener('click', function (e) {
        const btn = (e.target as HTMLElement).closest('button');
        if (!btn) return;
        const pick = (attr: string) => {
          pxctl.querySelectorAll(`button[data-${attr}]`).forEach((x) => x.classList.remove('on'));
          btn.classList.add('on');
        };
        if (btn.dataset.cell != null) {
          cell = +btn.dataset.cell; size(); pick('cell');
        } else if (btn.dataset.brush != null) {
          BRUSH = +btn.dataset.brush; pick('brush');
        }
      });
    }
  })();
</script>
