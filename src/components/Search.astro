---
// Search results panel + engine. The INPUT lives in the nav pill (Nav.astro);
// this panel is rendered at body level on purpose — the nav has a
// `backdrop-filter`, which makes it a containing block for fixed descendants
// and would trap the panel inside the pill.
import { projects, KIND_LABEL } from '../data/projects';
import { bookmarks } from '../data/bookmarks';

// one flat index over everything the site can send you to
const index = [
  ...projects.map((p) => ({
    t: p.name, s: p.blurb, u: p.url, x: !!p.external, g: 'Built', k: KIND_LABEL[p.kind],
  })),
  ...bookmarks.flatMap((grp) =>
    grp.items.map((b) => ({ t: b.name, s: b.note, u: b.url, x: true, g: 'Bookmarks', k: grp.group }))
  ),
];
---
<div class="search glass" id="searchPanel" hidden>
  <div class="search__results" id="searchResults" role="listbox" aria-label="Search results"></div>
  <p class="search__empty" id="searchEmpty" hidden>Nothing matches.</p>
  <p class="search__hint">
    <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
  </p>
</div>

<script type="application/json" id="searchIndex" set:html={JSON.stringify(index)}></script>

<style>
  .search {
    position: fixed; top: calc(var(--nav-gap) + var(--nav-h) + 10px); left: 50%;
    transform: translateX(-50%) translateY(-8px);
    width: min(560px, calc(100vw - 1.6rem));
    max-height: min(70vh, 520px);
    padding: 0.45rem;
    display: flex; flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius);
    opacity: 0; visibility: hidden;
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease), visibility 0.2s;
    box-shadow: 0 26px 70px rgba(0,0,0,0.18);
    z-index: 49;
  }
  .search.is-open { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .search[hidden] { display: none; }

  .search__results { overflow-y: auto; display: flex; flex-direction: column; gap: 0.1rem; }

  .search__empty {
    padding: 1rem 0.9rem; color: var(--text-faint);
    font-family: var(--font-mono); font-size: 0.78rem;
  }
  .search__empty[hidden] { display: none; }

  .search__hint {
    display: flex; gap: 1rem; flex-wrap: wrap;
    margin-top: 0.4rem; padding: 0.55rem 0.7rem 0.25rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-faint);
  }
  .search__hint span { display: inline-flex; align-items: center; gap: 0.3rem; }
  .search__hint kbd {
    font-family: inherit; font-size: 0.9em; line-height: 1;
    padding: 0.2rem 0.32rem; border: 1px solid var(--border);
    border-radius: 4px; color: var(--text-dim);
  }
  @media (max-width: 560px) { .search__hint { display: none; } }
  @media (prefers-reduced-motion: reduce) { .search { transition: none; } }
</style>

<!-- result rows are built by JS, so they can't carry Astro's scoped-style
     attribute — these rules are global, namespaced under .search -->
<style is:global>
  .search__group {
    padding: 0.6rem 0.7rem 0.3rem;
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--text-faint);
  }
  .search__item {
    display: flex; align-items: baseline; gap: 0.8rem;
    padding: 0.6rem 0.7rem; border-radius: var(--radius-sm);
    cursor: pointer; scroll-margin: 0.5rem;
  }
  .search__item:hover, .search__item.is-active { background: var(--panel-2); }
  .search__item-main { min-width: 0; flex: 1 1 auto; }
  .search__item-name {
    display: block; color: var(--text); font-size: 0.94rem; line-height: 1.3;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .search__item-note {
    display: block; color: var(--text-faint); font-size: 0.78rem; line-height: 1.4;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .search__item-kind {
    flex: 0 0 auto;
    font-family: var(--font-mono); font-size: 0.56rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--text-faint);
  }
  .search__item.is-active .search__item-kind { color: var(--accent); }
  .search mark { background: none; color: var(--accent); font-weight: 600; }
</style>

<script>
  interface Entry { t: string; s: string; u: string; x: boolean; g: string; k: string }

  const raw = document.getElementById('searchIndex')?.textContent || '[]';
  const INDEX: Entry[] = JSON.parse(raw);

  const input = document.getElementById('navSearch') as HTMLInputElement | null;
  const panel = document.getElementById('searchPanel');
  const results = document.getElementById('searchResults');
  const empty = document.getElementById('searchEmpty');

  if (input && panel && results && empty) {
    let active = -1;
    let hits: Entry[] = [];

    const close = () => {
      panel.classList.remove('is-open');
      panel.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };
    const open = () => {
      panel.hidden = false;
      // next frame so the transition runs from the hidden state
      requestAnimationFrame(() => panel.classList.add('is-open'));
      input.setAttribute('aria-expanded', 'true');
    };

    // build a text node run with the matched substring wrapped in <mark>.
    // Built as DOM nodes (never innerHTML) so a query can't inject markup.
    const withMark = (text: string, q: string) => {
      const frag = document.createDocumentFragment();
      const i = text.toLowerCase().indexOf(q);
      if (!q || i === -1) { frag.append(text); return frag; }
      frag.append(text.slice(0, i));
      const m = document.createElement('mark');
      m.append(text.slice(i, i + q.length));
      frag.append(m, text.slice(i + q.length));
      return frag;
    };

    const search = (q: string) => {
      const needle = q.trim().toLowerCase();
      if (!needle) return [];
      const scored = INDEX
        .map((e) => {
          const name = e.t.toLowerCase();
          const note = e.s.toLowerCase();
          // name match beats note match; a prefix beats a mid-string hit
          let score = -1;
          if (name.startsWith(needle)) score = 0;
          else if (name.includes(needle)) score = 1;
          else if (note.includes(needle)) score = 2;
          return { e, score };
        })
        .filter((r) => r.score >= 0)
        .sort((a, b) => a.score - b.score);
      // relevance decides WHAT gets in; group decides the display order, so
      // each group heading is emitted exactly once instead of repeating
      const GROUPS = ['Built', 'Bookmarks'];
      return scored
        .slice(0, 10)
        .map((r) => r.e)
        .sort((a, b) => GROUPS.indexOf(a.g) - GROUPS.indexOf(b.g));
    };

    const render = (q: string) => {
      hits = search(q);
      results.replaceChildren();
      active = hits.length ? 0 : -1;

      if (!q.trim()) { close(); return; }
      open();
      empty.hidden = hits.length > 0;

      let lastGroup = '';
      hits.forEach((e, i) => {
        if (e.g !== lastGroup) {
          lastGroup = e.g;
          const h = document.createElement('div');
          h.className = 'search__group';
          h.textContent = e.g;
          results.append(h);
        }
        const a = document.createElement('a');
        a.className = 'search__item' + (i === 0 ? ' is-active' : '');
        a.href = e.u;
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', String(i === 0));
        a.dataset.i = String(i);
        if (e.x) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }

        const main = document.createElement('span');
        main.className = 'search__item-main';
        const name = document.createElement('span');
        name.className = 'search__item-name';
        name.append(withMark(e.t, q.trim().toLowerCase()));
        const note = document.createElement('span');
        note.className = 'search__item-note';
        note.append(withMark(e.s, q.trim().toLowerCase()));
        main.append(name, note);

        const kind = document.createElement('span');
        kind.className = 'search__item-kind';
        kind.textContent = e.k;

        a.append(main, kind);
        a.addEventListener('mouseenter', () => setActive(i));
        results.append(a);
      });
    };

    const rows = () => [...results.querySelectorAll<HTMLElement>('.search__item')];
    const setActive = (i: number) => {
      const r = rows();
      if (!r.length) return;
      active = (i + r.length) % r.length;
      r.forEach((el, k) => {
        el.classList.toggle('is-active', k === active);
        el.setAttribute('aria-selected', String(k === active));
      });
      r[active].scrollIntoView({ block: 'nearest' });
    };

    input.addEventListener('input', () => render(input.value));
    input.addEventListener('focus', () => { if (input.value.trim()) render(input.value); });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        const r = rows();
        if (r[active]) { e.preventDefault(); r[active].click(); close(); input.blur(); }
      } else if (e.key === 'Escape') {
        if (input.value) { input.value = ''; render(''); }
        else { close(); input.blur(); }
      }
    });

    // "/" or ⌘/Ctrl-K from anywhere focuses the field
    document.addEventListener('keydown', (e) => {
      const el = document.activeElement;
      const typing = el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement
        || (el instanceof HTMLElement && el.isContentEditable);
      if (((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        e.preventDefault();
        input.focus();
        input.select();
      }
    });

    document.addEventListener('click', (e) => {
      const n = e.target as Node;
      if (!panel.contains(n) && !input.closest('.nav__search')?.contains(n)) close();
    });
  }
</script>
