---
import Grasshopper from './Grasshopper.astro';
import Search from './Search.astro';
const links = [
  { label: 'Built', href: '/#built' },
  { label: 'Bookmarks', href: '/#bookmarks' },
];
---
<header class="nav" id="nav">
  <a class="nav__brand" href="/" aria-label="Home">
    <Grasshopper class="nav__gh" />
  </a>

  <nav class="nav__links" aria-label="Primary">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>

  <div class="nav__search">
    <svg class="nav__search-icon" viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      <line x1="10.4" y1="10.4" x2="14" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      id="navSearch"
      class="nav__search-input"
      placeholder="Search"
      aria-label="Search everything built and bookmarked"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="searchPanel"
      aria-autocomplete="list"
    />
    <kbd class="nav__search-kbd" aria-hidden="true">/</kbd>
  </div>

  <button class="nav__burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
    <span class="nav__burger-box" aria-hidden="true"><span class="nav__burger-line"></span></span>
  </button>
</header>

<Search />

<!-- menu lives OUTSIDE the glass pill: a filtered/transformed ancestor would trap
     the fullscreen (position:fixed) variant. Body-level → true viewport anchoring. -->
<div class="nav__menu glass" id="navMenu">
  <nav aria-label="Menu">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</div>

<style>
  /* floating centered pill — detached from the top edge */
  .nav {
    position: fixed;
    top: 0.9rem;
    /* centre WITHOUT a transform, so the fullscreen menu (position:fixed) can
       escape to the viewport instead of being trapped by a transformed parent */
    left: 0; right: 0;
    margin-inline: auto;
    width: max-content;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.6vw, 1.9rem);
    height: 54px;
    padding: 0 0.55rem 0 1.25rem;
    max-width: calc(100vw - 1.6rem);
    border-radius: 100px;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(14, 14, 17, 0.78), rgba(8, 8, 10, 0.66));
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.5);
    transition: transform 0.4s var(--ease), opacity 0.35s var(--ease);
  }
  .nav.is-hidden {
    transform: translateY(calc(-100% - 1.2rem));
    opacity: 0;
    pointer-events: none;
  }

  /* colour only — no transform, so the mark never shifts out from under the cursor */
  .nav__brand { --gh-size: 34px; display: inline-flex; align-items: center; color: var(--accent); transition: color 0.2s var(--ease); }
  .nav__brand:hover { color: var(--text); }
  .nav__links { display: flex; gap: clamp(0.9rem, 2.6vw, 1.7rem); }
  .nav__links a { font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.04em; color: var(--text-dim); transition: color 0.2s; }
  .nav__links a:hover { color: var(--text); }
  /* ---- search field, in the bar ---- */
  .nav__search {
    position: relative;
    display: flex; align-items: center; gap: 0.45rem;
    height: 34px; padding: 0 0.5rem 0 0.6rem;
    border: 1px solid var(--border); border-radius: 100px;
    background: rgba(255,255,255,0.035);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .nav__search:focus-within { border-color: var(--border-bright); background: rgba(255,255,255,0.06); }
  .nav__search-icon { width: 13px; height: 13px; flex: 0 0 auto; color: var(--text-faint); }
  .nav__search:focus-within .nav__search-icon { color: var(--accent); }

  .nav__search-input {
    width: clamp(96px, 17vw, 190px);
    min-width: 0;
    border: 0; background: none; outline: none;
    color: var(--text);
    font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.02em;
  }
  .nav__search-input::placeholder { color: var(--text-faint); }
  /* the field carries its own affordance — drop the UA clear button */
  .nav__search-input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }

  .nav__search-kbd {
    flex: 0 0 auto;
    font-family: var(--font-mono); font-size: 0.62rem; line-height: 1;
    padding: 0.22rem 0.36rem;
    border: 1px solid var(--border); border-radius: 5px;
    color: var(--text-faint);
  }
  .nav__search:focus-within .nav__search-kbd { opacity: 0; }
  @media (max-width: 900px) { .nav__search-kbd { display: none; } }

  /* ---- hamburger (hidden until the taskbar can't fit, or in Minimal mode) ---- */
  .nav__burger { display: none; align-items: center; justify-content: center; width: 36px; height: 36px; background: transparent; border: none; color: var(--text); flex: 0 0 auto; }
  .nav__burger-box { position: relative; width: 18px; height: 12px; }
  .nav__burger-line, .nav__burger-line::before, .nav__burger-line::after {
    position: absolute; left: 0; width: 18px; height: 2px; background: currentColor; border-radius: 2px;
    transition: transform 0.3s var(--ease), opacity 0.2s var(--ease);
  }
  .nav__burger-line { top: 5px; }
  .nav__burger-line::before { content: ''; top: -5px; }
  .nav__burger-line::after { content: ''; top: 5px; }
  .nav__burger[aria-expanded="true"] .nav__burger-line { background: transparent; }
  .nav__burger[aria-expanded="true"] .nav__burger-line::before { top: 0; transform: rotate(45deg); }
  .nav__burger[aria-expanded="true"] .nav__burger-line::after { top: 0; transform: rotate(-45deg); }

  /* ---- the menu (dropdown, body-level) ----
     Fixed + body-level so the fullscreen variant anchors to the viewport. z-index below
     the nav (50) so the pill's burger stays on top to close it. */
  .nav__menu {
    position: fixed; top: calc(0.9rem + 54px + 10px); left: 50%;
    width: min(280px, calc(100vw - 1.6rem));
    padding: 0.55rem;
    display: flex; flex-direction: column; gap: 0.15rem;
    opacity: 0; visibility: hidden; transform: translateX(-50%) translateY(-8px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
    z-index: 49;
  }
  .nav__menu.is-open { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .nav__menu nav { display: flex; flex-direction: column; gap: 0.1rem; }
  .nav__menu a { padding: 0.7rem 0.9rem; border-radius: max(6px, calc(var(--radius-sm) - 6px)); color: var(--text-dim); font-family: var(--font-mono); font-size: 0.92rem; transition: color 0.2s, background 0.2s; }
  .nav__menu a:hover { color: var(--text); background: var(--panel-2); }
  .nav__menu-cta { justify-content: center; margin-top: 0.35rem; }

  /* show the burger when the inline links are hidden */
  @media (max-width: 720px) {
    .nav__links { display: none; }
    .nav__burger { display: inline-flex; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav, .nav__menu, .nav__burger-line, .nav__burger-line::before, .nav__burger-line::after { transition: none; }
  }
</style>

<script>
  const nav = document.getElementById('nav');
  const burger = document.getElementById('navBurger');
  const menu = document.getElementById('navMenu');

  // hide-on-scroll-down / reveal-on-scroll-up
  let last = window.scrollY;
  let ticking = false;
  const THRESHOLD = 6;
  function update() {
    const y = window.scrollY;
    if (y < 90) nav?.classList.remove('is-hidden');
    else if (y > last + THRESHOLD) { nav?.classList.add('is-hidden'); closeMenu(); }
    else if (y < last - THRESHOLD) nav?.classList.remove('is-hidden');
    last = y;
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });

  // hamburger menu
  function closeMenu() {
    menu?.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open menu');
  }
  burger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = menu?.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(!!open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('is-open') && !menu.contains(e.target as Node) && !burger?.contains(e.target as Node)) closeMenu();
  });
</script>
