---
import FlameGlobe from './FlameGlobe.astro';
import Search from './Search.astro';
const links = [
  { label: 'Built', href: '/#built' },
  { label: 'Bookmarks', href: '/#bookmarks' },
  { label: 'Contact', href: '/#contact' },
];
---
{/* Two independent floating pieces, not one bar — the logo pinned to the
    true top-left corner, and a small hamburger+search cluster centred.
    Neither carries .pxsafe: PixelField's grid (and heat/explosions) now
    render right through this whole area, same as everywhere else on the
    page — no punched-transparent "hole" sitting behind them. The search
    field stays legible on its own opaque pill; the logo just sits over
    whatever's there, same as it would over any busy background. */}
<a class="nav__brand nav-float" href="/" aria-label="Home">
  <FlameGlobe class="nav__mark" />
</a>

<div class="nav__cluster nav-float">
  {/* The menu button is deliberately NOT styled as a piece of UI chrome —
      idle, its 9 cells are just hairline outlines sized off --px-cell (the
      SAME size PixelField draws its own grid at), so it reads as nine empty
      grid squares rather than a button. Hovering dither-flickers them
      through the accent palette (PixelButton's trick); open fills them
      solid accent, same as a real "hot" cell in the background would look. */}
  <button class="nav__burger" id="navBurger" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">
    <span class="nav__grid" aria-hidden="true">
      <i></i><i></i><i></i>
      <i></i><i></i><i></i>
      <i></i><i></i><i></i>
    </span>
  </button>

  <div class="nav__search">
    <svg class="nav__search-icon" viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6" />
      <line x1="10.4" y1="10.4" x2="14" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <input
      type="search"
      id="navSearch"
      class="nav__search-input"
      placeholder="Search"
      aria-label="Search everything built and bookmarked"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="searchPanel"
      aria-autocomplete="list"
    />
    <kbd class="nav__search-kbd" aria-hidden="true">/</kbd>
  </div>
</div>

<Search />

<div class="nav__menu" id="navMenu">
  <nav class="nav__menu-panel glass" aria-label="Menu">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
</div>

<style>
  /* Both floating pieces hide/reveal on scroll together via the shared
     .nav-float class (there's no longer one parent element to toggle a
     class on — see the script). translate (not transform) carries both the
     fixed screen position and the hide-offset so a horizontal centring
     value and a vertical hide value never have to fight in one transform. */
  .nav-float {
    position: fixed;
    top: var(--nav-gap);
    z-index: 50;
    transition: translate 0.4s var(--ease);
  }
  .nav-float.is-hidden { pointer-events: none; }

  .nav__brand {
    left: var(--nav-gap);
    translate: 0 0;
    --mark-size: 24px; display: inline-flex; align-items: center;
    color: var(--accent);
    transition: color 0.2s var(--ease), translate 0.4s var(--ease);
  }
  .nav__brand:hover { color: var(--text); }
  .nav__brand.is-hidden { translate: 0 calc(-100% - var(--nav-gap)); }

  .nav__cluster {
    left: 50%;
    translate: -50% 0;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .nav__cluster.is-hidden { translate: -50% calc(-100% - var(--nav-gap)); }

  /* ---- search field — the one piece here that KEEPS an opaque fill, so
     the grid never shows through the actual input surface ---- */
  .nav__search {
    position: relative;
    display: flex; align-items: center; gap: 0.4rem;
    height: 27px; padding: 0 0.45rem 0 0.55rem;
    border: 1px solid var(--border); border-radius: 100px;
    background: var(--paper-alt);
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .nav__search:focus-within { border-color: var(--border-bright); background: var(--line-2); }
  .nav__search-icon { width: 12px; height: 12px; flex: 0 0 auto; color: var(--text-faint); }
  .nav__search:focus-within .nav__search-icon { color: var(--accent); }

  .nav__search-input {
    width: clamp(84px, 14vw, 160px);
    min-width: 0;
    border: 0; background: none; outline: none;
    color: var(--text);
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.02em;
  }
  .nav__search-input::placeholder { color: var(--text-faint); }
  /* the field carries its own affordance — drop the UA clear button */
  .nav__search-input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }

  .nav__search-kbd {
    flex: 0 0 auto;
    font-family: var(--font-mono); font-size: 0.62rem; line-height: 1;
    padding: 0.22rem 0.36rem;
    border: 1px solid var(--border); border-radius: 5px;
    color: var(--text-faint);
  }
  .nav__search:focus-within .nav__search-kbd { opacity: 0; }
  @media (max-width: 560px) { .nav__search-kbd { display: none; } }

  /* ---- menu button: camouflaged into the grid at rest ---- */
  .nav__burger {
    display: inline-flex; align-items: center; justify-content: center;
    padding: 6px;
    background: transparent; border: none;
    cursor: pointer; flex: 0 0 auto;
  }
  .nav__grid {
    display: grid;
    /* -1px + a 1px gap: cell walls sit on the same lines PixelField's own
       grid stroke would, so the icon lines up with the pattern around it
       instead of just approximating its size. */
    grid-template-columns: repeat(3, calc(var(--px-cell, 9px) - 1px));
    grid-template-rows: repeat(3, calc(var(--px-cell, 9px) - 1px));
    gap: 1px;
  }
  .nav__grid i {
    display: block;
    box-sizing: border-box;
    background: transparent;
    border: 1px solid var(--line);
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  /* open = solid accent, exactly like a "hot" cell in the real background */
  .nav__burger[aria-expanded="true"] .nav__grid i { background: var(--blue); border-color: var(--blue); }

  /* ---- the menu (dropdown, body-level) ----
     Fixed + body-level so it anchors to the viewport. Centred under the
     cluster (the burger's own position within it), same as the cluster. */
  .nav__menu {
    position: fixed;
    top: calc(var(--nav-gap) + var(--nav-h) + 8px);
    left: 50%;
    translate: -50% 0;
    display: flex;
    justify-content: center;
    z-index: 49;
    pointer-events: none;        /* positioner only — never eats clicks */
  }
  .nav__menu-panel {
    width: min(240px, calc(100vw - 1.6rem));
    padding: 0.55rem;
    display: flex; flex-direction: column; gap: 0.1rem;
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease), visibility 0.25s;
    pointer-events: auto;
  }
  .nav__menu.is-open .nav__menu-panel { opacity: 1; visibility: visible; transform: translateY(0); }
  .nav__menu a { padding: 0.7rem 0.9rem; border-radius: max(6px, calc(var(--radius-sm) - 6px)); color: var(--text-dim); font-family: var(--font-mono); font-size: 0.92rem; transition: color 0.2s, background 0.2s; }
  .nav__menu a:hover { color: var(--text); background: var(--panel-2); }

  @media (prefers-reduced-motion: reduce) {
    .nav-float, .nav__menu-panel, .nav__grid i { transition: none; }
  }
</style>

<script>
  const navFloats = [...document.querySelectorAll<HTMLElement>('.nav-float')];
  const burger = document.getElementById('navBurger');
  const menu = document.getElementById('navMenu');

  // hide-on-scroll-down / reveal-on-scroll-up — both floating pieces move together
  let last = window.scrollY;
  let ticking = false;
  const THRESHOLD = 6;
  function update() {
    const y = window.scrollY;
    if (y < 90) navFloats.forEach((el) => el.classList.remove('is-hidden'));
    else if (y > last + THRESHOLD) { navFloats.forEach((el) => el.classList.add('is-hidden')); closeMenu(); }
    else if (y < last - THRESHOLD) navFloats.forEach((el) => el.classList.remove('is-hidden'));
    last = y;
    ticking = false;
  }
  window.addEventListener('scroll', () => {
    if (!ticking) { requestAnimationFrame(update); ticking = true; }
  }, { passive: true });

  // hamburger menu
  function closeMenu() {
    menu?.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
    burger?.setAttribute('aria-label', 'Open menu');
  }
  burger?.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = menu?.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(!!open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
  document.addEventListener('click', (e) => {
    if (menu?.classList.contains('is-open') && !menu.contains(e.target as Node) && !burger?.contains(e.target as Node)) closeMenu();
  });

  // Menu-button dither flicker on hover — same technique as PixelButton's
  // hover fill. Setting style.background/borderColor to '' on mouseleave
  // clears the inline override entirely, so the stylesheet's idle (outline
  // only) or open (solid accent) rule takes back over rather than getting
  // stuck on whatever colour the flicker last landed on.
  const gridCells = burger ? [...burger.querySelectorAll<HTMLElement>('.nav__grid i')] : [];
  const ACCENTS = ['var(--neon)', 'var(--yellow)', 'var(--red)', 'var(--blue)'];
  let flickerTimer: number | null = null;
  function flickerTick() {
    gridCells.forEach((c) => {
      if (Math.random() < 0.55) {
        const col = ACCENTS[(Math.random() * ACCENTS.length) | 0];
        c.style.background = col;
        c.style.borderColor = col;
      } else {
        c.style.background = '';
        c.style.borderColor = '';
      }
    });
  }
  function flickerStop() {
    gridCells.forEach((c) => { c.style.background = ''; c.style.borderColor = ''; });
  }
  if (burger && gridCells.length && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    burger.addEventListener('mouseenter', () => {
      if (flickerTimer) return;
      flickerTick();
      flickerTimer = window.setInterval(flickerTick, 130);
    });
    burger.addEventListener('mouseleave', () => {
      if (flickerTimer !== null) { clearInterval(flickerTimer); flickerTimer = null; }
      flickerStop();
    });
  }
</script>
