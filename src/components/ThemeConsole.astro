---
import { styles, fonts, accents, options, presets } from '../data/themes';

// resolve each preset to the engine's config shape (font/accent → index)
const presetCfgs = presets.map((pr) => {
  const fi = fonts.findIndex((f) => f.label === pr.font);
  const ai = accents.findIndex((a) => a.label === pr.accent);
  return { s: pr.style, f: fi < 0 ? null : fi, a: ai < 0 ? null : ai, o: pr.opts || {} };
});
---
<aside class="console glass" id="console" data-open="false" aria-label="Design this site">
  <button class="console__toggle" id="consoleToggle" aria-expanded="false">
    <span class="console__spark" aria-hidden="true">✦</span>
    <span class="console__toggle-label">Design this site</span>
    <span class="console__chev" aria-hidden="true">▸</span>
  </button>

  <div class="console__panel" id="consolePanel">
    <p class="console__hint">You're the designer. Start from a preset, then flip anything — the whole site restyles live.</p>

    <div class="console__group">
      <span class="console__label">Presets ✦</span>
      <div class="console__row console__row--presets" data-ctl="preset">
        {presets.map((pr, i) => (
          <button class="chip chip--preset" data-cfg={JSON.stringify(presetCfgs[i])} title={pr.blurb}>{pr.name}</button>
        ))}
      </div>
      <div class="console__row console__row--presets" id="savedRow"></div>
      <button class="console__savebtn" data-act="save">＋ Save current look</button>
    </div>

    <div class="console__group">
      <span class="console__label">Vibe</span>
      <div class="console__row" data-ctl="style">
        {styles.map((s) => (
          <button class="chip" data-val={s.id} title={s.note}>{s.label}</button>
        ))}
      </div>
    </div>

    <div class="console__group">
      <span class="console__label">Type</span>
      <div class="console__row" data-ctl="font">
        {fonts.map((f, i) => (
          <button class="chip" data-val={i} style={`font-family:${f.display}`}>{f.label}</button>
        ))}
      </div>
    </div>

    <div class="console__group">
      <span class="console__label">Accent</span>
      <div class="console__row console__row--swatches" data-ctl="accent">
        {accents.map((a, i) => (
          <button class="swatch" data-val={i} title={a.label} aria-label={a.label} style={`background:${a.spectrum}`}></button>
        ))}
      </div>
    </div>

    <div class="console__group">
      <span class="console__label">Components</span>
      {options.map((op) => (
        <div class="console__opt">
          <span class="console__optlabel">{op.label}</span>
          <div class="console__row" data-ctl="opt" data-key={op.key}>
            {op.choices.map((c) => (
              <button class="chip chip--sm" data-val={c.val}>{c.label}</button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="console__actions">
      <button class="console__act" data-act="random">🎲 Surprise me</button>
      <button class="console__act" data-act="share">🔗 Copy link</button>
      <button class="console__act console__act--accent" data-act="export">⤓ Export CSS</button>
      <button class="console__act console__act--ghost" data-act="reset">Reset</button>
    </div>
    <textarea class="console__out" id="consoleOut" readonly hidden aria-label="Exported CSS tokens"></textarea>
  </div>
</aside>

<style>
  .console {
    position: fixed;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    z-index: 60;
    width: min(560px, calc(100vw - 1.4rem));
    padding: 0;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.55);
  }
  .console__toggle {
    display: flex; align-items: center; gap: 0.6rem;
    width: 100%; padding: 0.75rem 1.1rem;
    background: transparent; border: none; color: var(--text);
    font-family: var(--font-mono); font-size: 0.82rem; letter-spacing: 0.04em;
  }
  .console__spark { background: var(--spectrum); -webkit-background-clip: text; background-clip: text; color: transparent; font-size: 1rem; }
  .console__toggle-label { flex: 1; text-align: left; }
  .console__chev { color: var(--text-dim); transition: transform 0.3s var(--ease); }
  .console[data-open="true"] .console__chev { transform: rotate(90deg); }

  .console__panel {
    max-height: 0; opacity: 0; overflow: hidden;
    transition: max-height 0.4s var(--ease), opacity 0.3s var(--ease);
    padding: 0 1.1rem;
  }
  .console[data-open="true"] .console__panel { max-height: 60vh; opacity: 1; padding: 0 1.1rem 1rem; overflow-y: auto; }

  .console__hint { font-size: 0.78rem; color: var(--text-dim); margin: 0.2rem 0 0.9rem; line-height: 1.5; }
  .console__group { margin-bottom: 0.85rem; }
  .console__label { display: block; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-faint); margin-bottom: 0.45rem; }
  .console__row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .chip {
    padding: 0.4rem 0.75rem; border-radius: 100px;
    border: 1px solid var(--border); background: var(--panel-2);
    color: var(--text-dim); font-size: 0.78rem; line-height: 1;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }
  .chip:hover { color: var(--text); border-color: var(--border-bright); }
  .chip.is-active { color: var(--text); border-color: transparent; background: var(--accent-soft); box-shadow: inset 0 0 0 1.5px var(--accent); }

  .console__row--presets { gap: 0.4rem; }
  .chip--preset { border-color: color-mix(in srgb, var(--accent) 40%, var(--border)); background: var(--accent-soft); color: var(--text); }
  .chip--preset:hover { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 16%, transparent); transform: translateY(-1px); }
  .chip--saved { display: inline-flex; align-items: center; gap: 0.4rem; border-style: dashed; border-color: var(--border-bright); }
  .chip__x { display: inline-flex; width: 14px; height: 14px; align-items: center; justify-content: center; border-radius: 50%; font-size: 0.9rem; line-height: 1; color: var(--text-faint); }
  .chip__x:hover { color: var(--text); background: var(--panel-2); }
  .console__savebtn { margin-top: 0.5rem; width: 100%; padding: 0.5rem; border-radius: 10px; border: 1px dashed var(--border-bright); background: transparent; color: var(--text-dim); font-family: var(--font-mono); font-size: 0.76rem; transition: color 0.2s, border-color 0.2s; }
  .console__savebtn:hover { color: var(--text); border-color: var(--accent); }

  .console__row--swatches { gap: 0.5rem; }
  .swatch { width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border); padding: 0; transition: transform 0.15s var(--ease), box-shadow 0.2s; }
  .swatch:hover { transform: scale(1.12); }
  .swatch.is-active { box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--text); }

  .console__opt { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.4rem; }
  .console__optlabel { flex: 0 0 66px; font-size: 0.74rem; color: var(--text-dim); }
  .chip--sm { padding: 0.28rem 0.6rem; font-size: 0.72rem; }

  .console__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.4rem; padding-top: 0.8rem; border-top: 1px solid var(--border); }
  .console__act { flex: 1; min-width: 108px; padding: 0.55rem 0.7rem; border-radius: 10px; border: 1px solid var(--border-bright); background: var(--panel-2); color: var(--text); font-size: 0.78rem; font-family: var(--font-mono); transition: background 0.2s, border-color 0.2s; }
  .console__act:hover { background: var(--panel); border-color: var(--accent); }
  .console__act--ghost { flex: 0 0 auto; min-width: 0; color: var(--text-dim); border-color: var(--border); }
  .console__act--accent { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 55%, transparent); }
  .console__out { width: 100%; margin-top: 0.6rem; min-height: 148px; padding: 0.7rem 0.8rem; border-radius: 10px; border: 1px solid var(--border); background: rgba(0,0,0,0.32); color: var(--text-dim); font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.55; resize: vertical; white-space: pre; }

  @media (prefers-reduced-motion: reduce) {
    .console__panel, .console__chev { transition: none; }
  }
</style>

<script>
  const T = (window as any).__wsTheme;
  const console_ = document.getElementById('console');
  const toggle = document.getElementById('consoleToggle');
  const panel = document.getElementById('consolePanel');

  // open / close
  toggle?.addEventListener('click', () => {
    const open = console_?.getAttribute('data-open') === 'true';
    console_?.setAttribute('data-open', String(!open));
    toggle.setAttribute('aria-expanded', String(!open));
  });

  // external openers (e.g. the hero "Design this page live" button)
  document.querySelectorAll('[data-open-console]').forEach((b) => {
    b.addEventListener('click', () => {
      console_?.setAttribute('data-open', 'true');
      toggle?.setAttribute('aria-expanded', 'true');
      console_?.animate(
        [{ transform: 'translateX(-50%) scale(1.03)' }, { transform: 'translateX(-50%) scale(1)' }],
        { duration: 320, easing: 'ease-out' }
      );
    });
  });

  // control clicks (event-delegated)
  document.querySelectorAll<HTMLElement>('.console__row').forEach((row) => {
    const ctl = row.dataset.ctl;
    row.addEventListener('click', (e) => {
      if (ctl === 'preset') {
        const pbtn = (e.target as HTMLElement).closest<HTMLElement>('[data-cfg]');
        if (pbtn && T) T.apply(JSON.parse(pbtn.dataset.cfg!));
        return;
      }
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-val]');
      if (!btn || !T) return;
      const val = btn.dataset.val!;
      if (ctl === 'style') T.setStyle(val);
      else if (ctl === 'font') T.setFont(parseInt(val));
      else if (ctl === 'accent') T.setAccent(parseInt(val));
      else if (ctl === 'opt') T.setOpt(row.dataset.key!, val);
    });
  });

  // actions
  document.querySelectorAll<HTMLElement>('[data-act]').forEach((b) => {
    b.addEventListener('click', async () => {
      if (!T) return;
      const act = b.dataset.act;
      if (act === 'save') {
        const name = (window.prompt('Name this look:') || '').trim();
        if (!name) return;
        const s = T.state;
        const cfg = { s: s.s, f: s.f, a: s.a, o: Object.assign({}, s.o) };
        const list = getSaved(); list.push({ name, cfg }); setSaved(list); renderSaved();
      }
      else if (act === 'random') T.random();
      else if (act === 'reset') {
        T.reset();
        const out = document.getElementById('consoleOut') as HTMLTextAreaElement | null;
        if (out) out.hidden = true;
      }
      else if (act === 'share') {
        try {
          await navigator.clipboard.writeText(location.href);
          const prev = b.textContent;
          b.textContent = '✓ Copied!';
          setTimeout(() => (b.textContent = prev), 1400);
        } catch { /* clipboard blocked — no-op */ }
      }
      else if (act === 'export') {
        const root = document.documentElement;
        const cs = getComputedStyle(root);
        const vars = ['--bg','--bg-2','--panel','--border','--text','--text-dim','--hue','--accent','--spectrum','--radius','--font-display','--font-body','--font-hero'];
        const attrKeys = ['data-style','data-hero','data-nav','data-menu','data-burger','data-banner','data-corners','data-bg','data-cards','data-density','data-cursor','data-motion'];
        const attrs = attrKeys.filter((a) => root.hasAttribute(a)).map((a) => `${a}="${root.getAttribute(a)}"`).join(' ') || '(all defaults)';
        const bodyCss = vars.map((v) => `  ${v}: ${cs.getPropertyValue(v).trim()};`).join('\n');
        const out = `/* bwj95 web-studio — design tokens */\n/* preset → <html ${attrs}> */\n:root {\n${bodyCss}\n}`;
        const ta = document.getElementById('consoleOut') as HTMLTextAreaElement | null;
        if (ta) { ta.value = out; ta.hidden = false; ta.scrollIntoView({ block: 'nearest' }); }
        try {
          await navigator.clipboard.writeText(out);
          const prev = b.textContent;
          b.textContent = '✓ Copied CSS!';
          setTimeout(() => (b.textContent = prev), 1600);
        } catch { /* clipboard blocked — textarea still shows it */ }
      }
    });
  });

  // saved presets (localStorage) — your personal look library
  const SAVED_KEY = 'ws-saved';
  const savedRow = document.getElementById('savedRow');
  function getSaved(): { name: string; cfg: any }[] {
    try { return JSON.parse(localStorage.getItem(SAVED_KEY) || '[]'); } catch { return []; }
  }
  function setSaved(list: any[]) { try { localStorage.setItem(SAVED_KEY, JSON.stringify(list)); } catch { /* full/blocked */ } }
  function renderSaved() {
    if (!savedRow) return;
    const list = getSaved();
    savedRow.innerHTML = '';
    list.forEach((item, idx) => {
      const chip = document.createElement('button');
      chip.className = 'chip chip--saved';
      chip.textContent = item.name;
      chip.title = 'Apply saved look';
      chip.addEventListener('click', () => T && T.apply(item.cfg));
      const del = document.createElement('span');
      del.className = 'chip__x'; del.textContent = '×'; del.title = 'Delete';
      del.addEventListener('click', (e) => { e.stopPropagation(); const l = getSaved(); l.splice(idx, 1); setSaved(l); renderSaved(); });
      chip.appendChild(del);
      savedRow.appendChild(chip);
    });
  }
  renderSaved();

  // reflect current state onto the buttons (called by the engine after every change)
  (window as any).__wsSync = () => {
    if (!T) return;
    const s = T.state;
    document.querySelectorAll<HTMLElement>('[data-ctl="style"] [data-val]').forEach((el) =>
      el.classList.toggle('is-active', el.dataset.val === s.s));
    document.querySelectorAll<HTMLElement>('[data-ctl="font"] [data-val]').forEach((el) =>
      el.classList.toggle('is-active', s.f != null && +el.dataset.val! === s.f));
    document.querySelectorAll<HTMLElement>('[data-ctl="accent"] [data-val]').forEach((el) =>
      el.classList.toggle('is-active', s.a != null && +el.dataset.val! === s.a));
    // component options: active = current attribute value (or the option default)
    document.querySelectorAll<HTMLElement>('[data-ctl="opt"]').forEach((row) => {
      const op = (T.OPTIONS || []).find((o: any) => o.key === row.dataset.key);
      if (!op) return;
      const cur = document.documentElement.getAttribute(op.attr) || op.default;
      row.querySelectorAll<HTMLElement>('[data-val]').forEach((el) =>
        el.classList.toggle('is-active', el.dataset.val === cur));
    });
  };
  (window as any).__wsSync();
</script>
