---
// Scroll-driven statement: the block pins to the viewport and each word lights
// up as you scroll through it, then the whole thing releases. The classic
// "scroll storytelling" beat — built with a JS-driven scroll ratio + a per-word
// CSS custom property, NOT `animation-timeline` (Chromium-only).
//
// Props: text (the statement) + `accent`, a contiguous PHRASE within it that
// picks up the spectrum. Matching the phrase by position (not by word) means a
// common word like "the" is only highlighted where it belongs.
interface Props { text: string; accent?: string; eyebrow?: string; }
const { text, accent, eyebrow } = Astro.props;
const words = text.split(/\s+/);

// index range of the accent phrase, or [-1,-1] when absent / not found
const accentWords = accent ? accent.split(/\s+/) : [];
const bare = (w: string) => w.replace(/[^\w'’-]/g, '').toLowerCase();
let accentStart = -1;
if (accentWords.length) {
  const target = accentWords.map(bare);
  for (let i = 0; i + target.length <= words.length; i++) {
    if (target.every((t, k) => bare(words[i + k]) === t)) { accentStart = i; break; }
  }
}
const accentEnd = accentStart === -1 ? -1 : accentStart + accentWords.length - 1;
---
<section class="manifesto" data-manifesto>
  <div class="manifesto__sticky">
    <div class="wrap">
      {eyebrow && <p class="eyebrow manifesto__eyebrow">{eyebrow}</p>}
      <p class="manifesto__text display">
        {words.map((w, i) => (
          <span
            class:list={['manifesto__w', { 'manifesto__w--accent': i >= accentStart && i <= accentEnd && accentStart !== -1 }]}
          >{w}</span>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  /* tall track — the sticky child pins for its duration, giving the words room
     to light up one after another as you scroll */
  .manifesto { position: relative; height: 260svh; }
  .manifesto__sticky {
    position: sticky; top: 0;
    min-height: 100svh;
    display: flex; align-items: center;
  }
  .manifesto__eyebrow { margin-bottom: clamp(1.2rem, 3vw, 2rem); }

  .manifesto__text {
    font-size: clamp(1.7rem, 5.2vw, 4rem);
    line-height: 1.18;
    letter-spacing: -0.025em;
    max-width: 20ch;
  }

  /* --lit (0→1) is set per word by JS from the section's scroll progress.
     inline-block + an explicit margin supplies the word gap: the words are
     rendered as adjacent elements with no whitespace text nodes between them
     (Astro collapses those), so without this the sentence runs together. */
  .manifesto__w {
    --lit: 0;
    display: inline-block;
    margin-right: 0.26em;
    color: rgba(244, 244, 246, calc(0.12 + var(--lit) * 0.88));
    transition: color 0.18s linear;
  }
  /* accent words pick up the spectrum once they're lit */
  .manifesto__w--accent {
    background: var(--spectrum);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: calc(0.16 + var(--lit) * 0.84);
    transition: opacity 0.18s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .manifesto { height: auto; }
    .manifesto__sticky { position: static; min-height: 0; padding-block: clamp(4rem, 10vw, 8rem); }
    .manifesto__w { color: var(--text); }
    .manifesto__w--accent { opacity: 1; }
  }
</style>

<script>
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sections = [...document.querySelectorAll<HTMLElement>('[data-manifesto]')];

  if (!reduced && sections.length) {
    const blocks = sections.map((sec) => ({
      sec,
      words: [...sec.querySelectorAll<HTMLElement>('.manifesto__w')],
    }));

    let ticking = false;
    const apply = () => {
      const vh = window.innerHeight;
      for (const { sec, words } of blocks) {
        const r = sec.getBoundingClientRect();
        // progress 0→1 across the section's scrollable travel (its height minus
        // one viewport, which is the span the sticky child stays pinned for)
        const travel = Math.max(1, r.height - vh);
        const p = Math.min(1, Math.max(0, -r.top / travel));
        // the words light across the first 82% of the travel, so the finished
        // sentence holds fully lit for a beat before it releases
        const head = (p / 0.82) * words.length;
        words.forEach((w, i) => {
          const lit = Math.min(1, Math.max(0, head - i));
          w.style.setProperty('--lit', lit.toFixed(3));
        });
      }
      ticking = false;
    };

    apply();
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(apply); ticking = true; }
    }, { passive: true });
    window.addEventListener('resize', apply, { passive: true });
  }
</script>
