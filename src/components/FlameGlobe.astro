---
// The site's identity mark — a live green flame (bwj95.github.io is this site).
//
// NAME NOTE: the file is still FlameGlobe.astro (imported by Nav + footer, and
// mirrored by name in traditions + customizer) but the GLOBE IS GONE — this is
// now just the flame. Kept the filename to avoid rippling the imports/mirror.
//
// MIRRORED IN THREE REPOS — web-studio (bwj95.github.io), traditions-astro and
// customizer are separate git repos with no shared package, so this file is
// copied, not imported. If you change it, change all three or they drift.
//
// WHY A CANVAS, NOT SVG — the flame is meant to read like canvasui.dev's
// flame-wrap: turbulent licking ridges, a white-hot heart, rising DIGITAL embers
// (binary/hex glyphs, for the eventual "Spark Digital" name), and it
// has to bend toward the cursor and flare on click. That's a per-pixel noise
// fire; an SVG path (even morphed) can't do turbulence or react smoothly. Per the
// standing canvasui-look pattern we don't ship their WebGL — we rebuild the look
// in canvas2D on our own artwork.
//
// HOW IT STAYS CHEAP — the fire is computed into a tiny fixed buffer (48×64 fire
// cells) with a 3-octave fbm, then drawn UPSCALED with smoothing on, so it looks
// soft and organic at any --mark-size for a fixed per-frame cost (the buffer
// never grows). A SINGLE shared controller drives every flame on the page from
// one rAF and one global pointer, and pauses when nothing is on-screen.
//
// The flame is FIXED green (deep green → vivid green → white-hot heart),
// not currentColor. Override size with --mark-size.

interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<canvas class={`mark ${cls}`} data-flamemark role="img" aria-label="" aria-hidden="true"></canvas>

<style>
  .mark {
    /* a flame lives in a square box so nav/footer alignment doesn't shift; the
       fire just doesn't fill the corners */
    width: var(--mark-size, 32px);
    height: var(--mark-size, 32px);
    display: block;
    /* the fire blooms into the page — blur scales with size so it never smears a
       small mark (a fixed radius blurs a 32px mark's digits into mush) */
    filter: drop-shadow(0 0 calc(var(--mark-size, 32px) * 0.09) rgba(60, 220, 120, 0.5));
    touch-action: none;
  }
</style>

<script>
  // ── One shared controller for every flame mark on the page ──────────────────
  // Astro hoists + dedupes this module script, so it runs once no matter how many
  // <FlameGlobe/> render. It owns the rAF loop and the single global pointer.

  // Digital embers — for "Spark Digital": each rising spark is a binary/hex glyph
  // that flickers between characters as it climbs, instead of a round dot.
  type Spark = { x: number; y: number; vx: number; vy: number; life: number; max: number; r: number; hot: number; glyph: string; flip: number };

  // mostly 0/1 (binary), a sprinkle of hex — reads as "digital" at a glance
  function digit() {
    return Math.random() < 0.82
      ? (Math.random() < 0.5 ? '0' : '1')
      : '0123456789ABCDEF'[(Math.random() * 16) | 0];
  }

  type Flame = {
    el: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    fire: HTMLCanvasElement;   // offscreen fire buffer (1:1 with backing up to a cap)
    fctx: CanvasRenderingContext2D;
    img: ImageData;
    w: number; h: number;      // backing-store (device) px
    cssW: number; cssH: number;
    seed: number;              // desyncs each instance's flicker
    present: number; lean: number; flare: number; // smoothed state
    sparks: Spark[];
    spawn: number;             // fractional spark accumulator
    visible: boolean;
    fw: number; fh: number;    // fire-buffer resolution (tracks backing store)
    dprUsed: number;           // dpr the backing store was last sized for
  };

  // value-noise fbm — cheap, seamless enough for fire. 4 octaves for finer licks.
  function hash(x: number, y: number) {
    const n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
    return n - Math.floor(n);
  }
  function vnoise(x: number, y: number) {
    const xi = Math.floor(x), yi = Math.floor(y);
    const xf = x - xi, yf = y - yi;
    const u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
    const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
    return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
  }
  function fbm(x: number, y: number) {
    let s = 0, amp = 0.5, f = 1;
    for (let i = 0; i < 4; i++) { s += amp * vnoise(x * f, y * f); f *= 2; amp *= 0.5; }
    return s;
  }
  const smoothstep = (a: number, b: number, x: number) => {
    const t = Math.min(Math.max((x - a) / (b - a), 0), 1);
    return t * t * (3 - 2 * t);
  };

  function initController() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // global pointer, in client coords; -1 y means "no pointer yet"
    const ptr = { x: -1, y: -1, active: false };
    let clickAt = -1e9, clickX = 0, clickY = 0;

    window.addEventListener('pointermove', (e) => { ptr.x = e.clientX; ptr.y = e.clientY; ptr.active = true; }, { passive: true });
    window.addEventListener('pointerdown', (e) => { clickAt = performance.now(); clickX = e.clientX; clickY = e.clientY; ptr.x = e.clientX; ptr.y = e.clientY; ptr.active = true; }, { passive: true });
    // a touch/pointer leaving the window relaxes the flame back to idle
    window.addEventListener('pointerleave', () => { ptr.active = false; }, { passive: true });

    const flames: Flame[] = [];

    const clamp = (x: number, lo: number, hi: number) => Math.min(Math.max(x, lo), hi);

    function size(f: Flame) {
      // follow the real device-pixel-ratio (browser zoom raises it) up to 3, so a
      // zoomed-in mark gets a bigger backing store instead of a stretched raster
      const dpr = Math.min(window.devicePixelRatio || 1, 4);
      f.dprUsed = dpr;
      const r = f.el.getBoundingClientRect();
      f.cssW = r.width; f.cssH = r.height;
      f.w = Math.max(1, Math.round(r.width * dpr));
      f.h = Math.max(1, Math.round(r.height * dpr));
      f.el.width = f.w; f.el.height = f.h;
      f.ctx.imageSmoothingEnabled = true;
      (f.ctx as any).imageSmoothingQuality = 'high';
      // fire buffer TRACKS THE BACKING STORE 1:1 (up to a cap) — no upscale, so no
      // blur when zoomed; the value-noise is continuous, so 1:1 stays smooth, not
      // pixelated. Only past the cap (a very large mark) does it soften.
      const fw = clamp(f.w, 44, 280);
      const fh = clamp(f.h, 60, 340);
      if (fw !== f.fw || fh !== f.fh) {
        f.fw = fw; f.fh = fh;
        f.fire.width = fw; f.fire.height = fh;
        f.img = f.fctx.createImageData(fw, fh);
      }
    }

    document.querySelectorAll<HTMLCanvasElement>('canvas[data-flamemark]').forEach((el) => {
      const ctx = el.getContext('2d');
      if (!ctx) return;
      const fire = document.createElement('canvas');
      const fctx = fire.getContext('2d')!;
      const f: Flame = {
        el, ctx, fire, fctx, img: fctx.createImageData(1, 1),
        w: 0, h: 0, cssW: 0, cssH: 0, fw: 0, fh: 0, dprUsed: 0, seed: Math.random() * 100,
        present: 0, lean: 0, flare: 0, sparks: [], spawn: 0, visible: true,
      };
      size(f);
      flames.push(f);
    });

    if (!flames.length) return;

    // pause when off-screen — the footer flame costs nothing while scrolled away
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((ents) => {
        ents.forEach((en) => {
          const f = flames.find((x) => x.el === en.target);
          if (f) f.visible = en.isIntersecting;
        });
        kick();
      }, { rootMargin: '40px' });
      flames.forEach((f) => io.observe(f.el));
    }

    let ro: ResizeObserver | null = null;
    if ('ResizeObserver' in window) {
      ro = new ResizeObserver(() => flames.forEach(size));
      flames.forEach((f) => ro!.observe(f.el));
    }
    window.addEventListener('resize', () => flames.forEach(size), { passive: true });

    // ── the fire itself ──────────────────────────────────────────────────────
    function renderFire(f: Flame, time: number) {
      const FW = f.fw, FH = f.fh;
      const data = f.img.data;
      const t = time * 0.001;
      for (let y = 0; y < FH; y++) {
        const v = 1 - y / (FH - 1);                 // 0 at base (bottom), 1 at tip
        // TEARDROP width: narrow at the very root, widest in the lower third,
        // tightening again to the tip — a parabola in v whose minimum (widest
        // point) sits at ~0.30. No wide floor-skirt, no clipped band.
        const dv = v - 0.30;
        const kw = 3.2 + 16 * dv * dv;               // horizontal tightness
        // ROOT FADE: taper the bottom rows to zero so the base rounds and lifts
        // off the canvas floor instead of ending in a straight cut
        const root = smoothstep(0.0, 0.16, v);
        // steepen the falloff near the tip (the v*v term) so it tapers to a lick
        const rise = (v * 0.5 + v * v * 0.58) * (1 - f.flare * 0.26 - f.present * 0.14);
        for (let x = 0; x < FW; x++) {
          let u = (x / (FW - 1)) * 2 - 1;            // -1..1 across
          u += f.lean * v * v * 0.9;                 // bend toward the cursor, most at the tip
          const wind = Math.sin(t * 1.3 + v * 3.1 + f.seed) * 0.05;
          // higher base frequency + the 4th octave in fbm = finer licking ridges
          const turb = fbm((u + wind) * 3.3 + f.seed, v * 4.2 - t * 2.0);
          const shape = Math.exp(-(u * u) * kw) * root;
          let heat = (turb * 1.24 + 0.30) * shape - rise * root + f.flare * 0.22 * shape;
          if (heat <= 0.02) { const o = (y * FW + x) * 4; data[o + 3] = 0; continue; }
          heat = heat > 1 ? 1 : heat;
          // green-fire ramp: deep green → vivid green → white-hot heart
          const toGreen = Math.min(Math.max((heat - 0.10) / 0.34, 0), 1);
          const toWhite = Math.min(Math.max((heat - 0.56) / 0.34, 0), 1);
          let r = 16 + (86 - 16) * toGreen;
          let g = 108 + (236 - 108) * toGreen;
          let b = 44 + (120 - 44) * toGreen;
          r = r + (238 - r) * toWhite;
          g = g + (255 - g) * toWhite;
          b = b + (232 - b) * toWhite;
          const a = Math.min(Math.max((heat - 0.04) / 0.14, 0), 1);
          const o = (y * FW + x) * 4;
          data[o] = r; data[o + 1] = g; data[o + 2] = b; data[o + 3] = a * 255;
        }
      }
      f.fctx.putImageData(f.img, 0, 0);
    }

    function drawSparks(f: Flame, dt: number, time: number) {
      // spawn: idle trickle, more when the cursor is near, a burst is added on click
      const rate = (0.5 + f.present * 2.2) * (dt / 16.7);
      f.spawn += rate;
      while (f.spawn >= 1 && f.sparks.length < 24) {
        f.spawn -= 1;
        const u = (Math.random() - 0.5) * 0.5 + f.lean * 0.4;
        f.sparks.push({
          x: u, y: 0.16 + Math.random() * 0.16,
          vx: (Math.random() - 0.5) * 0.12, vy: 0.5 + Math.random() * 0.5,
          life: 0, max: 0.7 + Math.random() * 0.7,
          r: 0.6 + Math.random() * 0.9, hot: Math.random(),
          glyph: digit(), flip: Math.random() * 0.12,
        });
      }
      const ctx = f.ctx;
      ctx.save();
      ctx.globalCompositeOperation = 'lighter';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      for (let i = f.sparks.length - 1; i >= 0; i--) {
        const s = f.sparks[i];
        s.life += dt / 1000;
        if (s.life >= s.max) { f.sparks.splice(i, 1); continue; }
        const p = s.life / s.max;
        s.x += (s.vx + Math.sin(time * 0.004 + s.hot * 6.28) * 0.06) * (dt / 1000);
        s.y += s.vy * (dt / 1000);
        // flip to a new digit every ~120ms — the "digital" shimmer
        s.flip -= dt / 1000;
        if (s.flip <= 0) { s.glyph = digit(); s.flip = 0.09 + Math.random() * 0.14; }
        // snap to whole device pixels so the small glyphs render crisp, not soft
        const px = Math.round((s.x * 0.5 + 0.5) * f.w);
        const py = Math.round((1 - s.y) * f.h);
        const alpha = Math.sin(p * Math.PI) * 0.95;      // fade in + out
        // small digits: ~6% of the mark height, min 5px device, integer size
        const fontPx = Math.max(5, Math.round(f.h * (0.062 + (s.r - 0.6) * 0.025) * (1 - p * 0.2)));
        ctx.font = `700 ${fontPx}px ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace`;
        const hot = s.hot > 0.62;
        ctx.fillStyle = hot ? `rgba(236,255,238,${alpha})` : `rgba(130,240,150,${alpha})`;
        ctx.fillText(s.glyph, px, py);
      }
      ctx.restore();
    }

    function step(f: Flame, now: number, dt: number) {
      // target pointer state for THIS flame, from the global cursor vs its box
      let pTarget = 0, lTarget = 0, flareImpulse = 0;
      if (ptr.active && ptr.x >= 0) {
        const r = f.el.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        const dx = ptr.x - cx, dy = ptr.y - cy;
        const dist = Math.hypot(dx, dy);
        const reach = 200;
        pTarget = Math.max(0, 1 - dist / reach);
        lTarget = Math.max(-1, Math.min(1, dx / 120)) * pTarget;
        const since = now - clickAt;
        if (since < 320) {
          const cdist = Math.hypot(clickX - cx, clickY - cy);
          flareImpulse = Math.max(0, 1 - cdist / reach) * Math.exp(-since / 150);
        }
      }
      f.present += (pTarget - f.present) * 0.12;
      f.lean += (lTarget - f.lean) * 0.12;
      f.flare += (Math.max(flareImpulse, 0) - f.flare) * 0.25;

      renderFire(f, now + f.seed * 1000);
      f.ctx.clearRect(0, 0, f.w, f.h);
      f.ctx.drawImage(f.fire, 0, 0, f.w, f.h);
      drawSparks(f, dt, now);
    }

    let raf = 0, last = 0;
    function frame(now: number) {
      raf = 0;
      const dt = last ? Math.min(now - last, 50) : 16.7;
      last = now;
      let anyVisible = false;
      const curDpr = Math.min(window.devicePixelRatio || 1, 4);
      for (const f of flames) {
        if (!f.visible) continue;
        anyVisible = true;
        if (f.dprUsed !== curDpr) size(f);   // re-crisp on browser zoom
        step(f, now, dt);
      }
      if (anyVisible && !reduce) raf = requestAnimationFrame(frame);
    }
    function kick() { if (!raf && !reduce) { last = 0; raf = requestAnimationFrame(frame); } }

    document.addEventListener('visibilitychange', () => { if (!document.hidden) kick(); });

    if (reduce) {
      // one calm, centered frame — no motion, no pointer reaction
      for (const f of flames) { f.present = 0; f.lean = 0; f.flare = 0; step(f, 1200, 16.7); }
    } else {
      kick();
    }
  }

  if (!(window as any).__flameMark) {
    (window as any).__flameMark = true;
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initController);
    else initController();
  }
</script>
