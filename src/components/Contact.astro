---
// Contact section — a real POST form. It sends to the contact-worker (Cloudflare
// Worker), which emails the message via Resend. No address is exposed in the page
// and nothing is stored client-side.
//
// The endpoint's CORS allows bwj95.github.io + localhost:4321-4323, so this works
// both live and in `npm run dev` (dev posts to the same live worker).
import PixelButton from './PixelButton.astro';
const ENDPOINT = 'https://contact-worker.bwj9515.workers.dev/api/contact';
---
<section class="section wrap contact" id="contact">
  {/* Same dropdown pattern as a bookmarks group: a native <details>, closed by
      default, whose <summary> IS the section label. Works with JS off. */}
  <details class="contact__group" id="contactGroup">
    <summary class="contact__summary">
      <span class="contact__group-title">Contact</span>
      <span class="contact__chev" aria-hidden="true"></span>
    </summary>

    <div class="contact__grid">
      <div class="contact__intro">
        <h2 class="contact__title">Start a conversation.</h2>
        <p class="contact__lead">
          Have something to build, a question, or just want to say hello? Send a note —
          it lands straight in my inbox.
        </p>
      </div>

      <form class="contact__form glass" id="contactForm" novalidate>
        <div class="field">
          <label for="cf-name">Name</label>
          <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="field">
          <label for="cf-email">Email</label>
          <input id="cf-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="cf-message">Message</label>
          <textarea id="cf-message" name="message" rows="5" required minlength="5" maxlength="5000"></textarea>
        </div>

        <!-- honeypot: hidden from humans, catches bots. Real users leave it empty. -->
        <div class="field field--trap" aria-hidden="true">
          <label for="cf-website">Website</label>
          <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <!-- Cloudflare Turnstile: the real bot gate. Renders a light/no-friction
             check and injects a single-use token the worker verifies before send. -->
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        <div
          class="cf-turnstile"
          data-sitekey="0x4AAAAAAEVm0YWJdQxeYbbK"
          data-action="turnstile-spin-v2"
          data-theme="auto"
        ></div>

        <div class="contact__actions">
          <PixelButton class="contact__submit" id="cfSubmit" type="submit">
            <span class="contact__submit-label">Send message</span>
          </PixelButton>
          <p class="contact__status" id="cfStatus" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </details>
</section>

<style>
  .contact { padding-block: clamp(3rem, 7vw, 5.5rem); }

  /* ---- the dropdown header: same rule + chevron as a bookmarks group ---- */
  .contact__summary {
    display: flex; align-items: center; gap: 0.55rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
    cursor: pointer; list-style: none;
    transition: border-color 0.2s var(--ease);
  }
  .contact__summary::-webkit-details-marker { display: none; }
  .contact__summary:hover { border-color: var(--border-bright); }
  .contact__summary:hover .contact__group-title { color: var(--text-dim); }

  .contact__group-title {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.28em;
    text-transform: uppercase; color: var(--text-faint); font-weight: 400;
    transition: color 0.2s var(--ease);
  }
  .contact__chev {
    flex: 0 0 auto; width: 7px; height: 7px; margin-left: auto;
    border-right: 1.5px solid var(--text-faint); border-bottom: 1.5px solid var(--text-faint);
    transform: rotate(45deg) translate(-1px, -1px);
    transition: transform 0.25s var(--ease), border-color 0.2s var(--ease);
  }
  .contact__group[open] .contact__chev { transform: rotate(-135deg) translate(-1px, -1px); }
  .contact__summary:hover .contact__chev { border-color: var(--text-dim); }

  .contact__group[open] .contact__grid { animation: contact-open 0.32s steps(5) both; }
  @keyframes contact-open { from { opacity: 0; translate: 0 -6px; } to { opacity: 1; translate: 0 0; } }

  .contact__grid {
    display: grid; gap: clamp(1.6rem, 4vw, 3rem);
    padding-top: clamp(1.4rem, 3vw, 2rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) {
    .contact__grid { grid-template-columns: 0.85fr 1.15fr; align-items: start; }
  }

  .contact__title {
    font-size: clamp(1.6rem, 3.4vw, 2.3rem); line-height: 1.1; letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
  }
  .contact__lead { color: var(--text-dim); max-width: 42ch; line-height: 1.55; }

  .contact__form { padding: clamp(1.3rem, 3vw, 1.9rem); display: grid; gap: 1.05rem; }

  .field { display: grid; gap: 0.4rem; }
  .field label {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--text-dim);
  }
  .field input,
  .field textarea {
    width: 100%; font: inherit; color: var(--text);
    background: var(--bg-2); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 0.7rem 0.85rem;
    transition: border-color 0.18s var(--ease), box-shadow 0.18s var(--ease);
    resize: vertical;
  }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--text-faint); }
  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none; border-color: var(--border-bright);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  /* honeypot: kept in the DOM + tab order out, but visually gone */
  .field--trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .contact__actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.2rem; }

  /* button chrome (fill, dither hover, pixel-clipped corners) comes from
     PixelButton's own .pxbtn — this just covers the disabled state, which
     PixelButton doesn't need an opinion on (its buttons are never disabled). */
  :global(.contact__submit:disabled) { opacity: 0.55; cursor: default; }

  .contact__status { font-family: var(--font-mono); font-size: 0.8rem; margin: 0; color: var(--text-dim); }
  .contact__status.is-ok { color: hsl(150 70% 62%); }
  .contact__status.is-err { color: hsl(4 82% 68%); }

  @media (prefers-reduced-motion: reduce) {
    .field input, .field textarea, .contact__chev { transition: none; }
    .contact__group[open] .contact__grid { animation: none; }
  }
</style>

<script>
  // Opening is native. The only thing JS adds: any link that points at #contact
  // (nav, burger menu, a deep link on load) should OPEN the dropdown, not just
  // scroll to a closed one. A hashchange listener alone isn't enough — clicking
  // Contact while the hash is already #contact fires no hashchange.
  const group = document.getElementById('contactGroup') as HTMLDetailsElement | null;

  if (group) {
    const open = () => { group.open = true; };
    if (location.hash === '#contact') open();
    window.addEventListener('hashchange', () => { if (location.hash === '#contact') open(); });
    document.addEventListener('click', (e) => {
      if ((e.target as HTMLElement | null)?.closest?.('a[href$="#contact"]')) open();
    });
  }

  const ENDPOINT = 'https://contact-worker.bwj9515.workers.dev/api/contact';

  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const btn = document.getElementById('cfSubmit') as HTMLButtonElement | null;
  const status = document.getElementById('cfStatus');
  const label = form?.querySelector('.contact__submit-label') as HTMLElement | null;

  if (form && btn && status && label) {
    const setStatus = (msg: string, kind: '' | 'ok' | 'err' = '') => {
      status.textContent = msg;
      status.classList.toggle('is-ok', kind === 'ok');
      status.classList.toggle('is-err', kind === 'err');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      // Turnstile drops a single-use token into this hidden input once solved.
      const token =
        (form.elements.namedItem('cf-turnstile-response') as HTMLInputElement | null)?.value || '';
      if (!token) {
        setStatus('Please complete the verification check.', 'err');
        return;
      }

      const data = {
        name: (form.elements.namedItem('name') as HTMLInputElement).value,
        email: (form.elements.namedItem('email') as HTMLInputElement).value,
        message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
        website: (form.elements.namedItem('website') as HTMLInputElement).value, // honeypot
        token, // Turnstile token — verified server-side before anything is sent
      };

      btn.disabled = true;
      label.textContent = 'Sending…';
      setStatus('');

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) {
          form.reset();
          label.textContent = 'Send message';
          setStatus('Sent — thanks. I’ll get back to you.', 'ok');
        } else {
          label.textContent = 'Send message';
          setStatus(out.error || 'Could not send — please try again.', 'err');
        }
      } catch {
        label.textContent = 'Send message';
        setStatus('Network error — please try again.', 'err');
      } finally {
        btn.disabled = false;
        // Token is single-use — clear it so the next submit gets a fresh one.
        (window as any).turnstile?.reset();
      }
    });
  }
</script>
